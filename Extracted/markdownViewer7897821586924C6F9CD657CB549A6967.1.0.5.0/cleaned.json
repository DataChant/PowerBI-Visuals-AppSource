        "guid": "markdownViewer7897821586924C6F9CD657CB549A6967",
        "visualClassName": "Visual",
        "version": "1.0.5.0",
        "description": "Render Markdown content with syntax highlighting and emoji support in Power BI reports",
        "supportUrl": "https://www.atlynco.com/docs/faq",
        "gitHubUrl": "https://github.com/garrett-hamers/powerbi-markdown-viewer"
    },
    "author": {
        "name": "Atlyn",
        "email": "atlyn.help@gmail.com"
    },
    "apiVersion": "5.11.0",
    "style": "style/visual.less",
    "stringResources": {},
    "capabilities": {
        "dataRoles": [
            {
                "displayName": "Markdown Content",
                "name": "markdownContent",
                "kind": "Measure"
            }
        ],
        "objects": {
            "markdown": {
                "displayName": "Markdown Settings",
                "properties": {
                    "fontFamily": {
                        "displayName": "Font Family",
                        "type": {
                            "text": true
                        }
                    },
                    "fontSize": {
                        "displayName": "Font Size",
                        "type": {
                            "numeric": true
                        }
                    },
                    "fontColor": {
                        "displayName": "Font Color",
                        "type": {
                            "fill": {
                                "solid": {
                                    "color": true
                                }
                            }
                        }
                    },
                    "backgroundColor": {
                        "displayName": "Background Color",
                        "type": {
                            "fill": {
                                "solid": {
                                    "color": true
                                }
                            }
                        }
                    },
                    "padding": {
                        "displayName": "Padding",
                        "type": {
                            "numeric": true
                        }
                    },
                    "showBorder": {
                        "displayName": "Show Border",
                        "type": {
                            "bool": true
                        }
                    }
                }
            }
        },
        "dataViewMappings": [
            {
                "conditions": [
                    {
                        "markdownContent": {
                            "max": 1
                        }
                    }
                ],
                "single": {
                    "role": "markdownContent"
                }
            }
        ],
        "supportsHighlight": false,
        "supportsKeyboardFocus": true,
        "supportsLandingPage": true,
        "supportsEmptyDataView": true,
        "privileges": []
    },
