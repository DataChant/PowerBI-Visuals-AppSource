{
    "visual": {
        "name": "zentrixOrgChart",
        "displayName": "Zentrix Org Chart",
        "guid": "zentrixOrgChartEDA757DBC5794ED4A430098D374ED9A4",
        "visualClassName": "Visual",
        "version": "1.0.0.1",
        "description": "Draw any parent-child hierarchy as a tree of cards \u2014 org charts, chart of accounts, product hierarchies, bills of materials, legal-entity structures. It needs two fields: Person ID and Reports to. Big hierarchies stay readable: it opens with the deep levels folded behind a headcount, every level has its own switch, and a lens magnifies whatever is under the pointer. Any root shape works (blank, missing, dangling or self-referencing), reporting cycles can never hang it, and collapsed branches stay collapsed through a refresh. Everything is free: both orientations, photo cards, search, legend, zoom and fit, cross-filtering, dotted-line reporting, span-of-control metrics, conditional-formatting rules, period comparison, annotations and image export.",
        "supportUrl": "https://zentrixstudio.in/support",
        "gitHubUrl": "https://github.com/Zentrix-Studio/Org-Chart"
    },
    "author": {
        "name": "Zentrix Studio",
        "email": "support@zentrixstudio.in"
    },
    "apiVersion": "5.11.0",
