        "dataRoles": [
            {
                "displayName": "Card label",
                "name": "cardLabel",
                "kind": "Grouping",
                "description": "One card per value (e.g. KPI name, Region, Team)"
            },
            {
                "displayName": "Value",
                "name": "value",
                "kind": "Measure",
                "description": "The headline number on each card"
            },
            {
                "displayName": "Target",
                "name": "target",
                "kind": "Measure",
                "description": "Optional. Drives the band colour, delta pill, and target strip"
            },
            {
                "displayName": "Sort order",
                "name": "sortOrder",
                "kind": "Measure",
                "description": "Optional numeric sort key - cards follow it ascending"
            },
            {
                "displayName": "Tooltips",
                "name": "tooltips",
                "kind": "Measure",
                "description": "Extra measures for the hover tooltip"
            },
            {
                "displayName": "Change Value",
                "name": "changeValue",
                "kind": "Measure",
                "description": "Optional. An independent comparison, e.g. -0.18 for an 18% fall against the prior period. When bound it drives the pill, leaving Target to drive the band colour and target strip.",
                "requiredTypes": [
                    {
                        "numeric": true
                    }
                ]
            },
            {
                "displayName": "Change Label",
                "name": "changeLabel",
                "kind": "Measure",
                "description": "Optional. Text inside the pill. If blank, Change Value is formatted from its own model format."
            }
        ],
