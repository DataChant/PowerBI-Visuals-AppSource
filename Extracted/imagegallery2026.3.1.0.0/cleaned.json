    "visual": {
        "name": "imagegallery",
        "displayName": "ImageGallery",
        "guid": "imagegallery2026",
        "visualClassName": "Visual",
        "version": "3.1.0.0",
        "description": "Turn any table of image URLs into an interactive gallery with a modal viewer, zoom and cross-filtering. Export photo reports to PDF with a visual template designer, or to PowerPoint using your own corporate template. This visual retrieves images from the URLs in your data and, for exports, may use Invenia's optional cloud services (EU data residency, auto-deletion) \u2014 see the privacy policy at https://invenia.es/en/image-gallery/privacy-policy",
        "supportUrl": "https://invenia.es/en/image-gallery/support-and-documentation",
        "gitHubUrl": ""
    },
    "author": {
        "name": "INVENIA SOLUTIONS SL",
        "email": "support@invenia.es"
    },
