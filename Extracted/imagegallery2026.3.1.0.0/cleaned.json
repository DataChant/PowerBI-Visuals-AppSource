                "descriptionKey": "Role_PhotoUrlFields_Desc"
            }
        ],
        "dataViewMappings": [
            {
                "table": {
                    "rows": {
                        "select": [
                            {
                                "for": {
                                    "in": "imageUrl"
                                }
                            },
                            {
                                "for": {
                                    "in": "gridLine1"
                                }
                            },
                            {
                                "for": {
                                    "in": "gridLine2"
                                }
                            },
                            {
                                "for": {
                                    "in": "modalStoreName"
                                }
                            },
                            {
                                "for": {
                                    "in": "modalInfoFields"
                                }
                            },
                            {
                                "for": {
                                    "in": "exportFields"
                                }
                            },
                            {
                                "for": {
                                    "in": "photoUrlFields"
                                }
                            }
                        ],
                        "dataReductionAlgorithm": {
                            "top": {
                                "count": 2000
                            }
                        }
                    }
                },
                "conditions": [
                    {
                        "modalStoreName": {
                            "max": 1
                        }
                    }
                ]
            }
        ],
