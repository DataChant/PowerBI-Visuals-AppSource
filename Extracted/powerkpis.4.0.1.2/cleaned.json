{
    "visual": {
        "name": "powerKpis",
        "displayName": "PowerKPIs",
        "guid": "powerkpis",
        "visualClassName": "Visual",
        "version": "4.0.1.2",
        "description": "Add strategic insights to your PowerBI dashboards with PowerKPIs!",
        "supportUrl": "https://appsforpowerbi.infotopics.com",
        "gitHubUrl": ""
    },
    "author": {
        "name": "Infotopics | Apps for PowerBI",
        "email": "support@appsforpowerbi.infotopics.com"
    },
    "apiVersion": "5.11.0",
    "style": "style/visual.less",
    "stringResources": {},
    "capabilities": {
        "privileges": [
            {
                "name": "LocalStorage"
            },
            {
                "name": "WebAccess",
                "essential": true,
                "parameters": [
                    "*"
                ]
            }
        ],
        "dataRoles": [
            {
                "name": "date",
                "kind": "Grouping",
                "displayName": "Date"
            },
            {
                "name": "measures",
                "kind": "Measure",
                "displayName": "Measures",
                "requiredTypes": [
                    {
                        "numeric": true
                    }
                ]
            },
            {
                "name": "dimensions",
                "kind": "Grouping",
                "displayName": "Cards"
            },
            {
                "name": "scenarios",
                "kind": "Grouping",
                "displayName": "Scenarios"
            }
        ],
        "dataViewMappings": [
            {
                "conditions": [
                    {
                        "scenarios": {
                            "max": 1
                        }
                    }
                ],
                "table": {
                    "rows": {
                        "select": [
                            {
                                "for": {
                                    "in": "date"
                                }
                            },
                            {
                                "for": {
                                    "in": "dimensions"
                                }
                            },
                            {
                                "for": {
                                    "in": "scenarios"
                                }
                            },
                            {
                                "bind": {
                                    "to": "measures"
                                }
                            }
                        ],
                        "dataReductionAlgorithm": {
                            "window": {
                                "count": 5000
                            }
                        }
                    }
                }
            }
        ],
        "objects": {
            "mock": {
                "displayName": "API layer",
                "properties": {
                    "settings": {
                        "displayName": "Settings KV string",
                        "type": {
                            "text": true
                        }
                    }
                }
            },
            "licensing": {
                "displayName": "Licensing",
                "properties": {
                    "key": {
                        "displayName": "Key",
                        "type": {
                            "text": true
                        }
                    },
                    "company": {
                        "displayName": "Company",
                        "type": {
                            "text": true
                        }
                    },
                    "expiryDate": {
                        "displayName": "Expiry date",
                        "type": {
                            "text": true
                        }
                    },
                    "nOfUsers": {
                        "displayName": "Number of users",
                        "type": {
                            "text": true
                        }
                    },
                    "licenseType": {
                        "displayName": "License type",
                        "type": {
                            "text": true
                        }
                    },
                    "companyMail": {
                        "displayName": "Company E-mail",
                        "type": {
                            "text": true
                        }
                    },
                    "products": {
                        "displayName": "Supported products",
                        "type": {
                            "text": true
                        }
                    },
                    "modules": {
                        "displayName": "Supported modules",
                        "type": {
                            "text": true
                        }
                    }
                }
            },
            "extension": {
                "displayName": "Extension State",
                "properties": {
                    "key": {
                        "displayName": "License Key",
                        "type": {
                            "text": true
                        }
                    }
                }
            }
        },
        "supportsLandingPage": true,
        "supportsEmptyDataView": true,
        "suppressDefaultTitle": true,
        "supportsHighlight": false
    },
    "visualEntryPoint": "",
    "externalJS": [],
    "assets": {
        "icon": "./public/logo.png"
    }
}