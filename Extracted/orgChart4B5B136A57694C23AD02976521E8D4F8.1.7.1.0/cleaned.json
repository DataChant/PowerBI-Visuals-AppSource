        ],
        "dataViewMappings": [
            {
                "conditions": [
                    {
                        "name": {
                            "max": 1
                        },
                        "employeeId": {
                            "max": 1
                        },
                        "managerId": {
                            "max": 1
                        },
                        "jobTitle": {
                            "max": 1
                        },
                        "grade": {
                            "max": 1
                        },
                        "colorBy": {
                            "max": 1
                        },
                        "measure": {
                            "max": 1
                        }
                    }
                ],
                "categorical": {
                    "categories": {
                        "select": [
                            {
                                "for": {
                                    "in": "name"
                                }
                            },
                            {
                                "for": {
                                    "in": "employeeId"
                                }
                            },
                            {
                                "for": {
                                    "in": "managerId"
                                }
                            },
                            {
                                "for": {
                                    "in": "jobTitle"
                                }
                            },
                            {
                                "for": {
                                    "in": "grade"
                                }
                            },
                            {
                                "for": {
                                    "in": "colorBy"
                                }
                            }
                        ],
                        "dataReductionAlgorithm": {
                            "top": {
                                "count": 30000
                            }
                        }
                    },
                    "values": {
                        "select": [
                            {
                                "bind": {
                                    "to": "measure"
                                }
                            }
                        ]
                    }
                }
            }
        ],
