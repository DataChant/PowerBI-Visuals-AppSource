                "displayNameKey": "Role_JobTitle",
                "name": "jobTitle",
                "kind": "Grouping"
            },
            {
                "displayName": "Grade",
                "displayNameKey": "Role_Grade",
                "name": "grade",
                "kind": "Grouping"
            },
            {
                "displayName": "Colour By",
                "displayNameKey": "Role_ColorBy",
                "name": "colorBy",
                "kind": "Grouping"
