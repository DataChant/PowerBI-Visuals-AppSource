    "stringResources": {
        "en-US": {
            "Role_DataFields_Name": "Data fields",
            "Role_DataFields_Description": "Structural and descriptive fields available for semantic mapping.",
            "Role_Values_Name": "Values",
            "Role_Values_Description": "Optional measures and numeric fields used by diagram values and formatting.",
            "Role_Tooltips_Name": "Tooltips",
            "Role_Tooltips_Description": "Additional fields and measures shown in tooltips.",
            "Object_AdvancedEditor_Name": "Advanced editor",
            "Object_AdvancedEditor_Description": "Persisted Ataytis Assurance configuration.",
            "Property_ConfigJson_Name": "Diagram configuration",
            "Property_FormatPaneInfo_Name": "Configuration",
            "Property_FormatPaneInfo_Description": "Use Advanced edit mode to configure this visual."
        }
    },
    "capabilities": {
        "dataRoles": [
            {
                "name": "dataFields",
                "displayName": "Data fields",
                "displayNameKey": "Role_DataFields_Name",
                "description": "Columns that build the diagram: identifiers, parents, types and labels. Table columns only \u2014 measures belong in Values.",
                "descriptionKey": "Role_DataFields_Description",
                "kind": "Grouping"
            },
            {
                "name": "values",
                "displayName": "Values",
                "displayNameKey": "Role_Values_Name",
                "description": "Measures and numeric columns that drive values, conditional formatting and annotations. Also shown on hover and in the Node Inspector.",
                "descriptionKey": "Role_Values_Description",
                "kind": "GroupingOrMeasure"
            },
            {
                "name": "tooltips",
                "displayName": "Tooltips",
                "displayNameKey": "Role_Tooltips_Name",
                "description": "Extra detail to show on hover only. Nothing here changes the diagram.",
                "descriptionKey": "Role_Tooltips_Description",
                "kind": "GroupingOrMeasure"
            }
        ],
        "objects": {
            "advancedEditor": {
                "displayName": "Advanced editor",
                "displayNameKey": "Object_AdvancedEditor_Name",
                "description": "Persisted Ataytis Assurance configuration.",
                "descriptionKey": "Object_AdvancedEditor_Description",
                "properties": {
                    "configJson": {
                        "displayName": "Diagram configuration",
                        "displayNameKey": "Property_ConfigJson_Name",
                        "type": {
                            "text": true
                        }
                    },
                    "formatPaneInfo": {
                        "displayName": "Configuration",
                        "displayNameKey": "Property_FormatPaneInfo_Name",
                        "description": "Use Advanced edit mode to configure this visual.",
                        "descriptionKey": "Property_FormatPaneInfo_Description",
                        "type": {
                            "text": true
                        }
                    }
                }
            }
        },
        "dataViewMappings": [
            {
                "conditions": [
                    {
                        "dataFields": {
                            "max": 100
                        },
                        "values": {
                            "max": 100
                        },
                        "tooltips": {
                            "max": 100
                        }
                    }
                ],
                "table": {
                    "rows": {
                        "select": [
                            {
                                "for": {
                                    "in": "dataFields"
                                }
                            },
                            {
                                "for": {
                                    "in": "values"
                                }
                            },
                            {
                                "for": {
                                    "in": "tooltips"
                                }
                            }
                        ],
                        "dataReductionAlgorithm": {
                            "window": {
                                "count": 30000
                            }
                        }
                    }
                }
            }
        ],
        "sorting": {
            "custom": {}
        },
        "tooltips": {
            "supportedTypes": {
                "default": true,
                "canvas": true
            },
            "roles": [
                "dataFields",
                "values",
                "tooltips"
            ],
            "supportEnhancedTooltips": true
        },
        "privileges": [],
        "keepAllMetadataColumns": true,
        "supportsLandingPage": true,
        "supportsEmptyDataView": true,
        "supportsKeyboardFocus": true,
        "supportsMultiVisualSelection": true,
        "supportsHighlight": false,
        "advancedEditModeSupport": 2,
        "suppressDefaultTitle": true,
        "supportsOnObjectFormatting": false
    },
