                        "refDateMeasure": {
                            "max": 1
                        },
                        "granColumn": {
                            "max": 1
                        }
                    }
                ],
                "categorical": {
                    "categories": {
                        "select": [
                            {
                                "for": {
                                    "in": "dateColumn"
                                }
                            },
                            {
                                "for": {
                                    "in": "granColumn"
                                }
                            }
                        ],
                        "dataReductionAlgorithm": {
