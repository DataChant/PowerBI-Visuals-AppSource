{
    "visual": {
        "name": "dynamicMatrixHeatmap",
        "displayName": "Dynamic Matrix Heatmap",
        "guid": "dynamicMatrixHeatmap790912782D2A48CE80E680D64C793458",
        "visualClassName": "Visual",
        "version": "1.0.1.0",
        "description": "Let report readers pivot on their own: pick the X dimension, the Y dimension and the value from dropdowns inside the visual, with a global heatmap colour scale. Aggregates client-side, so distinct counts stay exact for any combination.",
        "supportUrl": "https://tinocallarisa-web.github.io/dynamic-matrix-heatmap/support.html",
        "gitHubUrl": "https://github.com/tinocallarisa-web/dynamic-matrix-heatmap"
    },
    "author": {
        "name": "TCViz",
        "email": "support@tcviz.com"
    },
    "apiVersion": "5.11.0",
    "style": "style/visual.less",
    "stringResources": {},
    "capabilities": {
        "dataRoles": [
            {
                "displayName": "Dimensions",
                "displayNameKey": "Visual_Dimensions",
                "name": "dimensions",
                "kind": "Grouping",
                "description": "Fields available in the X and Y dropdowns. Up to 10 (Free: 3)."
            },
            {
                "displayName": "Measures",
                "displayNameKey": "Visual_Measures",
                "name": "measures",
                "kind": "Measure",
                "description": "Pre-aggregated DAX measures. Re-aggregated with the mode selected in the Values card. Up to 5 (Free: 2)."
            },
            {
                "displayName": "Distinct count of (Pro)",
                "displayNameKey": "Visual_DistinctFields",
                "name": "distinctFields",
                "kind": "Grouping",
                "description": "Raw ID columns (e.g. customer_id). The visual counts unique values itself, so the result is always correct for any X/Y combination \u2014 unlike summing a DAX measure."
            }
        ],
        "dataViewMappings": [
            {
                "conditions": [
                    {
                        "dimensions": {
                            "min": 0,
                            "max": 10
                        },
                        "measures": {
                            "min": 0,
                            "max": 5
                        },
                        "distinctFields": {
                            "min": 0,
                            "max": 3
                        }
                    }
                ],
                "categorical": {
                    "categories": {
                        "select": [
                            {
                                "for": {
                                    "in": "dimensions"
                                }
                            },
                            {
                                "for": {
                                    "in": "distinctFields"
                                }
                            }
                        ],
                        "dataReductionAlgorithm": {
                            "window": {
                                "count": 30000
                            }
                        }
                    },
                    "values": {
                        "select": [
                            {
                                "for": {
                                    "in": "measures"
                                }
                            }
                        ]
                    }
                }
            }
        ],
        "objects": {
            "general": {
                "properties": {
                    "filter": {
                        "type": {
                            "filter": true
                        }
                    }
                }
            },
            "values": {
