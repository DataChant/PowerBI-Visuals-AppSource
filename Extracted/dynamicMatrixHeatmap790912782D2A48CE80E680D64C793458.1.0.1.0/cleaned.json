                "displayNameKey": "Visual_Values",
                "properties": {
                    "displayMode": {
                        "displayName": "Show value as (Pro)",
                        "type": {
                            "enumeration": [
                                {
                                    "value": "absolute",
                                    "displayName": "Absolute"
                                },
                                {
                                    "value": "pctRow",
                                    "displayName": "% of row"
                                },
                                {
                                    "value": "pctCol",
                                    "displayName": "% of column"
                                },
                                {
                                    "value": "pctTotal",
                                    "displayName": "% of grand total"
                                }
                            ]
                        }
                    },
                    "aggregation": {
                        "displayName": "Aggregation",
                        "description": "Auto reads the aggregation Power BI applied to the field. Override it when the field is a DAX measure, where the aggregation is not readable.",
                        "type": {
                            "enumeration": [
                                {
                                    "value": "auto",
                                    "displayName": "Auto (detect)"
                                },
                                {
