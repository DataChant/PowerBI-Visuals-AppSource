{
    "visual": {
        "name": "flowPath",
        "displayName": "FlowPath by Friven",
        "guid": "flowPath8C10DFEDFDA843738C13408A994374F4",
        "visualClassName": "Visual",
        "version": "1.0.0.0",
        "description": "Draws curved, weighted arrows between origins and destinations to visualize flows such as trade, migration, or shipments. Takes latitude and longitude, or place names resolved against a bundled list of cities - no geocoding service is called and no data leaves the report.",
        "supportUrl": "https://frivensolutions.github.io/flowpath-visual-docs/support.html",
        "gitHubUrl": "https://github.com/FrivenSolutions/flowpath-visual"
    },
    "author": {
        "name": "Justin Fritts",
        "email": "justin@friven.dev"
    },
    "apiVersion": "5.11.0",
    "style": "style/visual.less",
    "stringResources": {},
    "capabilities": {
        "dataRoles": [
            {
                "displayName": "Origin",
                "name": "origin",
                "kind": "Grouping",
                "description": "Text label identifying the origin point, used for data labels and tooltips"
            },
            {
                "displayName": "Origin Latitude",
                "name": "originLatitude",
                "kind": "Grouping",
                "description": "Latitude of the flow's starting point"
            },
            {
                "displayName": "Origin Longitude",
                "name": "originLongitude",
                "kind": "Grouping",
                "description": "Longitude of the flow's starting point"
            },
            {
                "displayName": "Origin Location",
                "name": "originLocation",
                "kind": "Grouping",
                "description": "Origin as City|State|Country, e.g. Denver|CO|USA - used only when Origin Latitude and Longitude are empty"
            },
            {
                "displayName": "Origin Size",
                "name": "originSize",
                "kind": "Measure",
                "description": "Optional measure sizing origin bubbles; without it they use a fixed size"
            },
            {
                "displayName": "Destination",
                "name": "destination",
                "kind": "Grouping",
                "description": "Text label identifying the destination point, used for data labels and tooltips"
            },
            {
                "displayName": "Destination Latitude",
                "name": "destLatitude",
                "kind": "Grouping",
                "description": "Latitude of the flow's ending point"
            },
            {
                "displayName": "Destination Longitude",
                "name": "destLongitude",
                "kind": "Grouping",
                "description": "Longitude of the flow's ending point"
            },
            {
                "displayName": "Destination Location",
                "name": "destLocation",
                "kind": "Grouping",
                "description": "Destination as City|State|Country, e.g. Rotterdam||NLD - used only when Destination Latitude and Longitude are empty"
            },
            {
                "displayName": "Destination Size",
                "name": "destinationSize",
                "kind": "Measure",
                "description": "Optional measure sizing destination bubbles; without it they use a fixed size"
            },
            {
                "displayName": "Origin Thickness",
                "name": "value",
                "kind": "Measure",
                "description": "Drives how thick each flow is drawn at its origin"
            },
            {
                "displayName": "Destination Thickness",
                "name": "destinationThickness",
                "kind": "Measure",
                "description": "Optional measure for the width at the destination; without it the flow keeps a constant width"
            },
            {
                "displayName": "Legend",
                "name": "legend",
                "kind": "Grouping",
                "description": "Categorical field used to color arrows and bubbles"
            },
            {
                "displayName": "Route ID",
                "name": "routeId",
                "kind": "Grouping",
                "description": "Optional. Rows sharing a value chain into one multi-leg route"
            },
            {
                "displayName": "Leg Order",
                "name": "legOrder",
                "kind": "Grouping",
                "description": "Optional. Position of this leg within its route (1, 2, 3...)"
            },
            {
                "displayName": "Start Time",
                "name": "time",
                "kind": "Grouping",
                "description": "Optional. Distinct values become playback steps on the timeline. Bind the date field itself rather than its date hierarchy"
            },
            {
                "displayName": "End Time",
                "name": "endTime",
                "kind": "Grouping",
                "description": "Optional. Keeps a flow on screen from its Start Time through to this value, instead of only at one step"
            },
            {
                "displayName": "Tooltips",
                "name": "tooltips",
                "kind": "Measure",
                "description": "Additional fields shown in the tooltip"
            }
        ],
