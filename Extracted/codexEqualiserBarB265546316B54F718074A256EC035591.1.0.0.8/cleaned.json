{
    "visual": {
        "name": "codexEqualiserBar",
        "displayName": "Codex Equalizer Bar",
        "guid": "codexEqualiserBarB265546316B54F718074A256EC035591",
        "visualClassName": "Visual",
        "version": "1.0.0.8",
        "description": "A column chart of discrete LED blocks - VU-meter DNA. Levels are block-quantised, unlit stubs keep the full grid visible, and a floating peak-hold block marks your Peak measure. Two colour modes: green-amber-red by level band, or spectrum-by-category on the brand ramp.",
        "supportUrl": "https://nexuscodex.nexus/support",
        "gitHubUrl": ""
    },
    "author": {
        "name": "Nexus Codex",
        "email": "support@nexuscodex.nexus"
    },
    "apiVersion": "5.11.0",
    "style": "style/visual.less",
    "stringResources": {
        "en-US": {
            "Visual_Short_Description": "Codex Visual",
            "Visual_Landing_Message": "Bind data to a Category and Value field to begin."
        }
    },
    "capabilities": {
        "dataRoles": [
            {
                "displayName": "Category",
                "name": "category",
                "kind": "Grouping",
                "description": "One column per category"
            },
            {
                "displayName": "Value",
                "name": "value",
                "kind": "Measure",
                "description": "Column level - blocks light up to this value"
            },
            {
                "displayName": "Peak / Target",
                "name": "peak",
                "kind": "Measure",
                "description": "Optional. Floating peak-hold block (period high, target, or prior period)"
            },
            {
                "displayName": "Sort order",
                "name": "sortOrder",
                "kind": "Measure",
                "description": "Optional numeric sort key - columns follow it ascending (e.g. month number)"
            },
            {
                "displayName": "Tooltips",
                "name": "tooltips",
                "kind": "Measure",
                "description": "Extra measures for the hover tooltip"
            }
        ],
        "dataViewMappings": [
            {
                "conditions": [
                    {
                        "category": {
                            "max": 1
                        },
                        "value": {
                            "max": 1
                        },
                        "peak": {
                            "max": 1
                        },
                        "sortOrder": {
                            "max": 1
                        }
                    }
                ],
                "categorical": {
                    "categories": {
                        "for": {
                            "in": "category"
                        },
                        "dataReductionAlgorithm": {
                            "top": {
                                "count": 100
                            }
                        }
                    },
                    "values": {
                        "select": [
                            {
                                "bind": {
                                    "to": "value"
                                }
                            },
                            {
                                "bind": {
                                    "to": "peak"
                                }
                            },
                            {
                                "bind": {
                                    "to": "sortOrder"
                                }
                            },
                            {
                                "for": {
                                    "in": "tooltips"
                                }
                            }
                        ]
                    }
                }
            }
        ],
