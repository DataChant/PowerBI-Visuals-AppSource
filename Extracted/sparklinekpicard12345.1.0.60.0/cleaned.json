{
    "visual": {
        "name": "sparklinekpicard",
        "displayName": "Sparkline KPI Card",
        "guid": "sparklinekpicard12345",
        "visualClassName": "Visual",
        "version": "1.0.60.0",
        "description": "KPI card with an embedded sparkline trend: a headline measure with up to two comparison measures, variance indicator, cross-filtering and a granularity-aware date axis.",
        "supportUrl": "https://convergentbt.com/cbt-custom-visuals/sparkline-kpi-card",
        "gitHubUrl": "https://github.com/Convergent-Business-Technologies/PBIVC-Sparkline-KPI-Card"
    },
    "author": {
        "name": "Sajiah",
        "email": "sajiah.razeen@convergentbt.com"
    },
    "apiVersion": "5.11.0",
    "style": "style/visual.less",
    "stringResources": {},
    "capabilities": {
        "dataRoles": [
            {
                "displayName": "KPI Measure 1",
                "description": "The measure shown as the headline KPI number AND plotted as the sparkline across the Date axis (required). Drives both \u00e2\u20ac\u201d there is no separate trend field, so the sparkline always follows the selected KPI measure / field parameter.",
                "name": "kpiMeasure",
                "kind": "Measure"
            },
            {
                "displayName": "Date Axis",
                "description": "Categories (usually dates) that drive the sparkline horizontal axis ordering.",
                "name": "dateAxis",
                "kind": "GroupingOrMeasure"
            },
            {
                "displayName": "KPI Measure 2",
                "description": "Optional target/goal value used for the Variance and Trend indicators.",
                "name": "targetMeasure",
                "kind": "Measure"
            },
            {
                "displayName": "KPI Measure 3",
                "description": "Optional previous-period value used for the Variance and Trend indicators.",
                "name": "previousMeasure",
                "kind": "Measure"
            },
            {
                "displayName": "KPI Measure 1 Font Color",
                "description": "Optional DAX measure returning a colour, used as the KPI value's font colour and overriding the KPI Value card's own swatch. Write the condition in DAX, e.g. Color = IF([Sales] > [Sales Target], \"#35cf46\", \"#d64554\"). Accepts #RGB / #RRGGBB / #RRGGBBAA, rgb()/rgba(), or a CSS colour name. This replaces the conditional-formatting (fx) button, which Power BI does not support on matrix-based visuals.",
                "name": "kpiColor",
                "kind": "Measure"
            },
            {
                "displayName": "KPI Measure 2 Font Color",
                "description": "Optional DAX measure returning a colour, used as the Target value's font colour and overriding the Target Value card's own swatch. Same format and purpose as KPI Value Font Color.",
                "name": "targetColor",
                "kind": "Measure"
            },
            {
                "displayName": "KPI Measure 3 Font Color",
                "description": "Optional DAX measure returning a colour, used as the Previous value's font colour and overriding the Previous Value card's own swatch. Same format and purpose as KPI Value Font Color.",
                "name": "previousColor",
                "kind": "Measure"
            }
        ],
