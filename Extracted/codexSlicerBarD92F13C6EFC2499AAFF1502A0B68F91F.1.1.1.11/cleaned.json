        "gitHubUrl": "https://github.com/Nexus-Codex-pbi/codex-slicer-bar"
    },
    "author": {
        "name": "Nexus Codex",
        "email": "support@nexuscodex.nexus"
    },
    "apiVersion": "5.11.0",
    "style": "style/visual.less",
    "stringResources": {
        "en-US": {
            "Visual_Short_Description": "Drop fields to configure slicer sections",
