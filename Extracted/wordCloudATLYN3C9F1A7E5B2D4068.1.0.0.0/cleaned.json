        "dataViewMappings": [
            {
                "conditions": [
                    {
                        "Category": {
                            "min": 1,
                            "max": 1
                        },
                        "Values": {
                            "min": 0,
                            "max": 1
                        },
                        "Sentiment": {
                            "min": 0,
                            "max": 1
                        },
                        "Excludes": {
                            "min": 0,
                            "max": 1
                        },
                        "tooltips": {
                            "min": 0
                        }
                    }
                ],
                "categorical": {
                    "categories": {
                        "select": [
                            {
                                "for": {
                                    "in": "Category"
                                }
                            },
                            {
                                "for": {
                                    "in": "Excludes"
                                }
                            }
                        ],
                        "dataReductionAlgorithm": {
                            "top": {
                                "count": 30000
                            }
                        }
                    },
                    "values": {
                        "select": [
                            {
                                "bind": {
                                    "to": "Values"
                                }
                            },
                            {
                                "bind": {
                                    "to": "Sentiment"
                                }
                            },
                            {
                                "for": {
                                    "in": "tooltips"
                                }
                            }
                        ]
                    }
                }
            }
        ],
