            "Role_Values_Desc": "Optional measure that weights each word. Omit to weight by frequency.",
            "Role_Sentiment": "Sentiment",
            "Role_Sentiment_Desc": "Optional per-row sentiment score used only to colour words, never to size them.",
            "Role_Excludes": "Excludes",
            "Role_Excludes_Desc": "Optional field listing words to drop from the cloud",
            "Role_Tooltips": "Tooltips",
            "Role_Tooltips_Desc": "Additional measures to show in tooltips",
