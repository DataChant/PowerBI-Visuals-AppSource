            "Card_Title": "Title",
            "Card_Interaction": "Interaction",
            "General_MaxWords": "Max Words",
            "General_MaxWords_Desc": "Upper bound on how many distinct words are laid out",
            "General_WeightMode": "Weight By",
            "General_WeightMode_Desc": "How font size is derived. Measure sizing falls back to word frequency when no Values measure is supplied. Distinctiveness (TF-IDF) surfaces terms unique to few rows.",
            "General_MinFontSize": "Min Font Size",
            "General_MaxFontSize": "Max Font Size",
            "General_ScaleMode": "Size Scale",
            "General_ScaleMode_Desc": "How weights map to font size. Sqrt and Log compress large ranges.",
            "General_Rotation": "Rotation",
            "General_BreakWords": "Split Into Words",
            "General_BreakWords_Desc": "Off treats each cell as a single phrase",
            "General_StripPunctuation": "Remove Punctuation",
            "General_CaseInsensitive": "Ignore Case",
            "General_MinWordLength": "Min Word Length",
            "General_MinRepetitions": "Min Occurrences",
