            "General_ShowOverflowNote_Desc": "Report words that did not fit instead of dropping them silently",
            "General_LayoutSeed": "Layout Seed",
            "General_LayoutSeed_Desc": "0 derives a stable seed from the data. Change it to reshuffle.",
            "StopWords_Show": "Apply Stop Words",
            "StopWords_UseDefaults": "Use Default List",
            "StopWords_UseDefaults_Desc": "Common English words such as the, and, of",
            "StopWords_Words": "Custom Stop Words",
            "Design_FontFamily": "Font Family",
            "Design_UseUniformColor": "Single Colour",
            "Design_UniformColor": "Word Colour",
            "Design_Padding": "Word Spacing",
            "Title_Show": "Show Title",
            "Title_TitleText": "Title Text",
            "Title_FontSize": "Font Size",
            "Title_FontColor": "Font Color",
            "Title_Alignment": "Alignment",
            "Card_Sentiment": "Sentiment",
            "Sentiment_Source": "Sentiment Source",
            "Sentiment_Source_Desc": "Colour words by sentiment. Measure uses the Sentiment field; Built-in scores the text with an offline English VADER lexicon.",
            "Sentiment_Negative": "Negative",
            "Sentiment_Neutral": "Neutral",
            "Sentiment_Positive": "Positive",
            "Sentiment_RangeMode": "Score Range",
            "Sentiment_RangeMode_Desc": "Auto derives the range from the data. Custom pins explicit negative/neutral/positive anchor scores.",
            "Sentiment_RangeMin": "Min (Negative)",
            "Sentiment_RangeNeutral": "Midpoint (Neutral)",
            "Sentiment_RangeMax": "Max (Positive)",
            "Sentiment_NoCoverage": "words without sentiment coverage",
