    "capabilities": {
        "supportsKeyboardFocus": true,
        "supportsLandingPage": true,
        "supportsEmptyDataView": true,
        "supportsHighlight": true,
        "supportsMultiVisualSelection": true,
        "tooltips": {
            "supportedTypes": {
                "default": true,
                "canvas": true
            },
            "roles": [
                "tooltips"
            ]
        },
        "dataRoles": [
            {
                "displayName": "Words",
                "displayNameKey": "Role_Words",
                "name": "Category",
                "kind": "Grouping",
                "description": "Text field to build the cloud from (e.g., Comment, Tag, Keyword)",
                "descriptionKey": "Role_Words_Desc"
            },
            {
                "displayName": "Values",
                "displayNameKey": "Role_Values",
                "name": "Values",
                "kind": "Measure",
                "description": "Optional measure that weights each word. Omit to weight by frequency.",
                "descriptionKey": "Role_Values_Desc"
            },
            {
                "displayName": "Sentiment",
                "displayNameKey": "Role_Sentiment",
                "name": "Sentiment",
                "kind": "Measure",
                "description": "Optional per-row sentiment score used only to colour words, never to size them.",
                "descriptionKey": "Role_Sentiment_Desc"
            },
            {
                "displayName": "Excludes",
                "displayNameKey": "Role_Excludes",
                "name": "Excludes",
                "kind": "Grouping",
                "description": "Optional field listing words to drop from the cloud",
                "descriptionKey": "Role_Excludes_Desc"
            },
            {
                "displayName": "Tooltips",
                "displayNameKey": "Role_Tooltips",
                "name": "tooltips",
                "kind": "Measure",
                "description": "Additional measures to show in tooltips",
                "descriptionKey": "Role_Tooltips_Desc"
            }
        ],
