        "dataViewMappings": [
            {
                "conditions": [
                    {
                        "Date": {
                            "min": 1,
                            "max": 1
                        },
                        "Values": {
                            "min": 0,
                            "max": 1
                        },
                        "Tooltips": {
                            "min": 0,
                            "max": 10
                        }
                    }
                ],
                "categorical": {
                    "categories": {
                        "for": {
                            "in": "Date"
                        },
                        "dataReductionAlgorithm": {
                            "top": {
                                "count": 30000
                            }
                        }
                    },
                    "values": {
                        "select": [
                            {
                                "bind": {
                                    "to": "Values"
                                }
                            },
                            {
                                "for": {
                                    "in": "Tooltips"
                                }
                            }
                        ]
                    }
                }
            }
        ],
