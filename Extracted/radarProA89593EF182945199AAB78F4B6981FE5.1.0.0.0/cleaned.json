    "visual": {
        "name": "radarPro",
        "displayName": "Radar & Polar Pro by PBIStack",
        "guid": "radarProA89593EF182945199AAB78F4B6981FE5",
        "visualClassName": "Visual",
        "version": "1.0.0.0",
        "description": "Radar and spider charts that start at zero, label every ring, and let each axis carry its own scale. Targets with gap emphasis, honest handling of missing values, measures-as-axes for KPI scorecards, pinned spoke order, and a readability warning when a web gets too crowded.",
        "supportUrl": "https://pbistack.com/support/",
        "gitHubUrl": ""
    },
