            "roles": [
                "category"
            ]
        },
        "dataRoles": [
            {
                "displayName": "Axis (one spoke per value)",
                "description": "A category field: each distinct value becomes one spoke of the web. Leave this empty and put several measures in Values instead \u2014 then each MEASURE becomes a spoke.",
                "name": "category",
                "kind": "Grouping"
            },
            {
                "displayName": "Legend (one shape per value)",
                "description": "Optional. Each distinct value becomes one polygon on the web.",
                "name": "series",
                "kind": "Grouping"
            },
            {
                "displayName": "Values",
                "description": "The measure plotted along each spoke. Add SEVERAL measures with the Axis well empty and each measure becomes its own spoke.",
                "name": "values",
                "kind": "Measure"
            },
            {
                "displayName": "Target",
                "description": "Optional. Draws a target ring or polygon, enables percent-of-target scaling and the gap emphasis.",
                "name": "target",
                "kind": "Measure"
            },
            {
                "displayName": "Tooltips",
                "description": "Extra fields to show on hover.",
                "name": "tooltips",
                "kind": "Measure"
            }
        ],
        "dataViewMappings": [
            {
                "conditions": [
                    {
                        "category": {
                            "max": 1
                        },
                        "series": {
                            "max": 1
                        },
                        "values": {
                            "min": 0
                        },
                        "target": {
                            "max": 1
                        }
                    }
                ],
                "categorical": {
                    "categories": {
                        "for": {
                            "in": "category"
                        },
                        "dataReductionAlgorithm": {
                            "top": {
                                "count": 30000
                            }
                        }
                    },
                    "values": {
                        "group": {
                            "by": "series",
                            "select": [
                                {
                                    "bind": {
                                        "to": "values"
                                    }
                                },
                                {
                                    "bind": {
                                        "to": "target"
                                    }
                                },
                                {
                                    "bind": {
                                        "to": "tooltips"
                                    }
                                }
                            ],
                            "dataReductionAlgorithm": {
                                "top": {
                                    "count": 100
                                }
                            }
                        }
                    }
                }
            }
        ],
