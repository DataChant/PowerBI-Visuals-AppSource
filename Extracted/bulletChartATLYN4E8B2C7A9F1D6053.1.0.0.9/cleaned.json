{
    "visual": {
        "name": "atlynBulletChart",
        "displayName": "Atlyn Bullet Chart",
        "guid": "bulletChartATLYN4E8B2C7A9F1D6053",
        "visualClassName": "Visual",
        "version": "1.0.0.9",
        "description": "Free Bullet chart for Power BI. Compare an actual measure against a target with qualitative ranges.",
        "supportUrl": "https://www.atlynco.com/docs/faq",
        "gitHubUrl": ""
    },
    "author": {
        "name": "Atlyn",
        "email": "partner@atlynco.com"
    },
    "apiVersion": "5.11.0",
    "style": "style/visual.less",
    "stringResources": {},
    "capabilities": {
        "supportsHighlight": true,
        "supportsKeyboardFocus": true,
        "supportsLandingPage": true,
        "supportsEmptyDataView": true,
        "supportsMultiVisualSelection": true,
        "tooltips": {
            "supportedTypes": {
                "default": true,
                "canvas": true
            },
            "roles": [
                "tooltips"
            ]
        },
        "dataRoles": [
            {
                "displayName": "Category",
                "name": "category",
                "kind": "Grouping",
                "description": "KPI name (e.g., Revenue, Satisfaction)"
            },
            {
                "displayName": "Actual",
                "name": "actual",
                "kind": "Measure",
                "description": "Current/actual value"
            },
            {
                "displayName": "Target",
                "name": "target",
                "kind": "Measure",
                "description": "Target/goal value (rendered as a vertical marker line)"
            },
            {
                "displayName": "Maximum",
                "name": "maximum",
                "kind": "Measure",
                "description": "Maximum scale value (auto-calculated if not provided)"
            },
            {
                "displayName": "Tooltips",
                "name": "tooltips",
                "kind": "Measure",
                "description": "Additional measures to show in tooltips"
            }
        ],
        "objects": {
            "chartSettings": {
                "properties": {
                    "orientation": {
                        "type": {
                            "enumeration": [
                                {
                                    "value": "horizontal",
                                    "displayName": "Horizontal"
                                },
                                {
                                    "value": "vertical",
                                    "displayName": "Vertical"
                                }
                            ]
                        }
                    },
                    "scaleMode": {
                        "type": {
                            "enumeration": [
                                {
                                    "value": "individual",
                                    "displayName": "Individual"
                                },
                                {
                                    "value": "shared",
                                    "displayName": "Shared"
                                }
                            ]
                        }
                    },
                    "showQualitativeRanges": {
                        "type": {
                            "bool": true
                        }
                    },
                    "poorThreshold": {
                        "type": {
                            "numeric": true
                        }
                    },
                    "satisfactoryThreshold": {
                        "type": {
                            "numeric": true
                        }
                    }
                }
            },
            "title": {
                "properties": {
                    "show": {
                        "type": {
                            "bool": true
                        }
                    },
                    "titleText": {
                        "type": {
                            "text": true
                        }
                    },
                    "fontSize": {
                        "type": {
                            "numeric": true
                        }
                    },
                    "fontColor": {
                        "type": {
                            "fill": {
                                "solid": {
                                    "color": true
                                }
                            }
                        }
                    },
                    "alignment": {
                        "type": {
                            "enumeration": [
                                {
                                    "value": "left",
                                    "displayName": "Left"
                                },
                                {
                                    "value": "center",
                                    "displayName": "Center"
                                },
                                {
                                    "value": "right",
                                    "displayName": "Right"
                                }
                            ]
                        }
                    }
                }
            },
            "dataLabels": {
                "properties": {
                    "show": {
                        "type": {
                            "bool": true
                        }
                    },
                    "fontSize": {
                        "type": {
                            "numeric": true
                        }
                    },
                    "decimalPlaces": {
                        "type": {
                            "numeric": true
                        }
                    },
                    "displayUnits": {
                        "type": {
                            "enumeration": [
                                {
                                    "value": "auto",
                                    "displayName": "Auto"
                                },
                                {
                                    "value": "none",
                                    "displayName": "None"
                                },
                                {
                                    "value": "thousands",
                                    "displayName": "Thousands (K)"
                                },
                                {
                                    "value": "millions",
                                    "displayName": "Millions (M)"
                                },
                                {
                                    "value": "billions",
                                    "displayName": "Billions (B)"
                                }
                            ]
                        }
                    },
                    "showTarget": {
                        "type": {
                            "bool": true
                        }
                    }
                }
            },
            "categories": {
                "properties": {
                    "show": {
                        "type": {
                            "bool": true
                        }
                    },
                    "fontSize": {
                        "type": {
                            "numeric": true
                        }
                    },
                    "fontColor": {
                        "type": {
                            "fill": {
                                "solid": {
                                    "color": true
                                }
                            }
                        }
                    },
                    "maxWidth": {
                        "type": {
                            "numeric": true
                        }
                    }
                }
            },
            "design": {
                "properties": {
                    "actualColor": {
                        "type": {
                            "fill": {
                                "solid": {
                                    "color": true
                                }
                            }
                        }
                    },
                    "targetColor": {
                        "type": {
                            "fill": {
                                "solid": {
                                    "color": true
                                }
                            }
                        }
                    },
                    "targetWidth": {
                        "type": {
                            "numeric": true
                        }
                    },
                    "range1Color": {
                        "type": {
                            "fill": {
                                "solid": {
                                    "color": true
                                }
                            }
                        }
                    },
                    "range2Color": {
                        "type": {
                            "fill": {
                                "solid": {
                                    "color": true
                                }
                            }
                        }
                    },
                    "range3Color": {
                        "type": {
                            "fill": {
                                "solid": {
                                    "color": true
                                }
                            }
                        }
                    },
                    "barHeight": {
                        "type": {
                            "numeric": true
                        }
                    }
                }
            },
            "interaction": {
                "properties": {
                    "enableSelection": {
                        "type": {
                            "bool": true
                        }
                    },
                    "enableTooltips": {
                        "type": {
                            "bool": true
                        }
                    }
                }
            }
        },
        "dataViewMappings": [
            {
                "conditions": [
                    {
                        "category": {
                            "max": 1
                        },
                        "actual": {
                            "max": 1
                        },
                        "target": {
                            "max": 1
                        },
                        "maximum": {
                            "max": 1
                        },
                        "tooltips": {
                            "max": 25
                        }
                    }
                ],
                "categorical": {
                    "categories": {
                        "select": [
                            {
                                "for": {
                                    "in": "category"
                                }
                            }
                        ],
                        "dataReductionAlgorithm": {
                            "top": {
                                "count": 1000
                            }
                        }
                    },
                    "values": {
                        "select": [
                            {
                                "bind": {
                                    "to": "actual"
                                }
                            },
                            {
                                "bind": {
                                    "to": "target"
                                }
                            },
                            {
                                "bind": {
                                    "to": "maximum"
                                }
                            },
                            {
                                "for": {
                                    "in": "tooltips"
                                }
                            }
                        ]
                    }
                }
            }
        ],
        "privileges": []
    },
    "visualEntryPoint": "",
    "externalJS": [],
    "assets": {
        "icon": "assets/icon.png"
    }
}