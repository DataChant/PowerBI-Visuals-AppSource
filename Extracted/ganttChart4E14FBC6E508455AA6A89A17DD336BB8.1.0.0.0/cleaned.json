{
    "visual": {
        "name": "smartVisualsGanttChart",
        "displayName": "SmartVisuals Gantt Chart",
        "guid": "ganttChart4E14FBC6E508455AA6A89A17DD336BB8",
        "visualClassName": "Visual",
        "version": "1.0.0.0",
        "description": "Professional Gantt chart with progress, dependencies and critical-path analysis. Part of the SmartVisuals visual family for Power BI.",
        "supportUrl": "https://smartvisuals.io/support",
        "gitHubUrl": ""
    },
    "author": {
        "name": "SmartVisuals",
        "email": "hello@smartvisuals.io"
    },
    "apiVersion": "5.11.0",
    "style": "style/visual.less",
    "stringResources": {},
    "capabilities": {
        "dataRoles": [
            {
                "name": "task",
                "kind": "Grouping",
                "displayName": "Task",
                "description": "Task or activity name"
            },
            {
                "name": "category",
                "kind": "Grouping",
                "displayName": "Category / Group",
                "description": "Optional grouping category for color coding"
            },
            {
                "name": "parent",
                "kind": "Grouping",
                "displayName": "Parent Task",
                "description": "Optional parent task name \u2014 builds a collapsible work-breakdown hierarchy with rollup summary bars"
            },
            {
                "name": "extraColumns",
                "kind": "Grouping",
                "displayName": "Grid Columns",
                "description": "Optional extra columns (up to 3) shown as a sortable data grid next to task names \u2014 e.g. Owner, Status, Cost. Premium feature."
            },
            {
                "name": "startDate",
                "kind": "Measure",
                "displayName": "Start Date",
                "description": "Task start date"
            },
            {
                "name": "endDate",
                "kind": "Measure",
                "displayName": "End Date",
                "description": "Task end date"
            },
            {
                "name": "progress",
                "kind": "Measure",
                "displayName": "Progress %",
                "description": "Task completion percentage (0\u2013100)"
            },
            {
                "name": "dependencies",
                "kind": "Grouping",
                "displayName": "Dependencies",
                "description": "Predecessor task name(s), comma-separated \u2014 powers dependency arrows and critical-path analysis. Premium feature."
            },
            {
                "name": "baselineStart",
                "kind": "Measure",
                "displayName": "Baseline Start",
                "description": "Planned start date \u2014 renders a baseline ghost bar for plan-vs-actual comparison. Premium feature."
            },
            {
                "name": "baselineEnd",
                "kind": "Measure",
                "displayName": "Baseline End",
                "description": "Planned end date \u2014 renders a baseline ghost bar for plan-vs-actual comparison. Premium feature."
            },
            {
                "name": "tooltips",
                "kind": "Measure",
                "displayName": "Tooltips",
                "description": "Extra fields shown in the task tooltip"
            }
        ],
        "dataViewMappings": [
            {
                "conditions": [
                    {
                        "task": {
                            "max": 1
                        },
                        "category": {
                            "max": 1
                        },
                        "parent": {
                            "max": 1
                        },
                        "extraColumns": {
                            "max": 3
                        },
                        "dependencies": {
                            "max": 1
                        },
                        "startDate": {
                            "max": 1
                        },
                        "endDate": {
                            "max": 1
                        },
                        "progress": {
                            "max": 1
                        },
                        "baselineStart": {
                            "max": 1
                        },
                        "baselineEnd": {
                            "max": 1
                        }
                    }
                ],
                "categorical": {
                    "categories": {
                        "select": [
                            {
                                "bind": {
                                    "to": "task"
                                }
                            },
                            {
                                "bind": {
                                    "to": "category"
                                }
                            },
                            {
                                "bind": {
                                    "to": "parent"
                                }
                            },
                            {
                                "for": {
                                    "in": "extraColumns"
                                }
                            },
                            {
                                "bind": {
                                    "to": "dependencies"
                                }
                            }
                        ],
                        "dataReductionAlgorithm": {
                            "top": {
                                "count": 1000
                            }
                        }
                    },
                    "values": {
                        "select": [
                            {
                                "bind": {
                                    "to": "startDate"
                                }
                            },
                            {
                                "bind": {
                                    "to": "endDate"
                                }
                            },
                            {
                                "bind": {
                                    "to": "progress"
                                }
                            },
                            {
                                "bind": {
                                    "to": "baselineStart"
                                }
                            },
                            {
                                "bind": {
                                    "to": "baselineEnd"
                                }
                            },
                            {
                                "for": {
                                    "in": "tooltips"
                                }
                            }
                        ]
                    }
                }
            }
        ],
