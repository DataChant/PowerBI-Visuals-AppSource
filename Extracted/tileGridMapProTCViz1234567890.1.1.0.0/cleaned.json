{
    "visual": {
        "name": "tileGridMapPro",
        "displayName": "Tile Grid Map Pro",
        "guid": "tileGridMapProTCViz1234567890",
        "visualClassName": "Visual",
        "version": "1.1.0.0",
        "description": "Visualize geographic data as interactive tile grids. Supports 27 countries and regions with precise boundaries. Free uses up to 500 rows; Pro uses up to 30,000 rows and adds circle and hexagon tiles, sizing by a second measure, quantile, diverging and categorical scales, custom colours and your own TopoJSON regions.",
        "supportUrl": "https://tinocallarisa-web.github.io/tile-grid-map-pro/support.html",
        "gitHubUrl": "https://github.com/tinocallarisa-web/tile-grid-map-pro"
    },
    "author": {
        "name": "TCViz",
        "email": "support@tcviz.com"
    },
    "apiVersion": "5.10.0",
    "style": "style/visual.less",
    "stringResources": {
        "en-US": {
            "visual_displayName": "Tile Grid Map Pro",
            "visual_description": "Point data aggregated onto square tile grids for 27 countries and regions, plus your own TopoJSON regions (Pro). No map service, no network calls.",
            "mapSettings_displayName": "Map Settings",
            "mapSettings_country_displayName": "Country / Region",
            "mapSettings_aggregationType_displayName": "Value Aggregation",
            "mapSettings_showEmptyCells_displayName": "Show Empty Cells",
            "mapSettings_showLabels_displayName": "Show Cell Labels",
            "mapSettings_labelFontSize_displayName": "Label Font Size",
            "mapSettings_labelMinTileSize_displayName": "Label Min Tile Size (px)",
            "mapSettings_tooltipDecimals_displayName": "Decimal Places",
            "colorScale_displayName": "Color Scale",
            "colorScale_scaleType_displayName": "Scale Type",
            "colorScale_colorMin_displayName": "Color Min (Pro)",
            "colorScale_colorMid_displayName": "Color Mid (Pro, Diverging)",
            "colorScale_colorMax_displayName": "Color Max (Pro)",
            "colorScale_noDataColor_displayName": "No Data Color",
            "legend_displayName": "Legend",
            "legend_showLegend_displayName": "Show Legend",
            "legend_legendPosition_displayName": "Position",
            "mapSettings_tileShape_displayName": "Tile Shape",
            "mapSettings_latitudeCorrection_displayName": "Correct Latitude Distortion",
            "legend_fontFamily_displayName": "Font",
            "legend_fontSize_displayName": "Text Size",
            "legend_fontColor_displayName": "Text Color"
        }
    },
    "capabilities": {
        "dataRoles": [
            {
                "name": "latitude",
                "kind": "Grouping",
                "displayName": "Latitude",
                "description": "Latitude column (decimal degrees, e.g. 40.4168)"
            },
            {
                "name": "longitude",
                "kind": "Grouping",
                "displayName": "Longitude",
                "description": "Longitude column (decimal degrees, e.g. -3.7038)"
            },
            {
                "name": "value",
                "kind": "Measure",
                "displayName": "Value",
                "description": "Numeric value to color each tile"
            },
            {
                "name": "size",
                "kind": "Measure",
                "displayName": "Size (Pro)",
                "description": "Optional second measure that sizes each tile"
            },
            {
                "name": "tooltips",
                "kind": "Measure",
                "displayName": "Tooltips",
                "description": "Additional fields shown in tooltip"
            },
            {
                "name": "label",
                "kind": "Grouping",
                "displayName": "Label",
                "description": "Optional display name (city, region...)"
            },
            {
                "name": "category",
                "kind": "Grouping",
                "displayName": "Category",
                "description": "Group used by the Categorical colour scale (Pro): each tile takes the category with most rows"
            }
        ],
        "dataViewMappings": [
            {
                "conditions": [
                    {
                        "latitude": {
                            "max": 1
                        },
                        "longitude": {
                            "max": 1
                        },
                        "value": {
                            "max": 1
                        },
                        "tooltips": {
                            "max": 10
                        },
                        "label": {
                            "max": 1
                        },
                        "size": {
                            "max": 1
                        },
                        "category": {
                            "max": 1
                        }
                    }
                ],
                "table": {
                    "rows": {
                        "select": [
                            {
                                "for": {
                                    "in": "latitude"
                                }
                            },
                            {
                                "for": {
                                    "in": "longitude"
                                }
                            },
                            {
                                "for": {
                                    "in": "label"
                                }
                            },
                            {
                                "for": {
                                    "in": "category"
                                }
                            },
                            {
                                "bind": {
                                    "to": "value"
                                }
                            },
                            {
                                "bind": {
                                    "to": "tooltips"
                                }
                            },
                            {
                                "bind": {
                                    "to": "size"
                                }
                            }
                        ],
                        "dataReductionAlgorithm": {
                            "top": {
                                "count": 30000
                            }
                        }
                    }
                }
            }
        ],
