{
    "visual": {
        "name": "mapTale",
        "displayName": "MapTale",
        "guid": "mapTale11B5B672EA591B56D99FDCD9FCD37515",
        "visualClassName": "Visual",
        "version": "2.3.9.0",
        "description": "MapTale by DataTale: a project map for Power BI, all in one visual. Boundary layers with labels and click-to-filter, greyscale-to-imagery zoom, clustering, status-coloured category icons, project popups with photo carousels, in-map header with slicers and search, legend, stats and 3D buildings. No map accounts, API keys, per-user licences or usage fees.",
        "supportUrl": "https://datatale.com.au/maptale/",
        "gitHubUrl": ""
    },
    "author": {
        "name": "DataTale",
        "email": "warren.dean@datatale.com.au"
    },
    "apiVersion": "5.11.0",
    "style": "style/visual.less",
    "stringResources": {},
    "capabilities": {
        "privileges": [
            {
                "name": "WebAccess",
                "essential": true,
                "parameters": [
                    "https://*"
                ]
            }
        ],
        "dataRoles": [
            {
                "name": "id",
                "displayName": "ID",
                "description": "A column that uniquely identifies each row. Drives selection and cross-filtering.",
                "kind": "Grouping"
            },
            {
                "name": "latitude",
                "displayName": "Latitude",
                "kind": "Grouping",
                "requiredTypes": [
                    {
                        "numeric": true
                    }
                ],
                "preferredTypes": [
                    {
                        "geography": {
                            "latitude": true
                        }
                    }
                ],
                "description": "Decimal latitude of each marker."
            },
            {
                "name": "longitude",
                "displayName": "Longitude",
                "kind": "Grouping",
                "requiredTypes": [
                    {
                        "numeric": true
                    }
                ],
                "preferredTypes": [
                    {
                        "geography": {
                            "longitude": true
                        }
                    }
                ],
                "description": "Decimal longitude of each marker."
            },
            {
                "name": "category",
                "displayName": "Category",
                "description": "Its values become the marker icons, the filter buttons, the legend rows, the chart bars and the Category dropdown.",
                "kind": "Grouping"
            },
            {
                "name": "status",
                "displayName": "Status",
                "description": "Each value gets a colour (Format > Status colours) on the markers, popup, legend and stats card, and feeds the Status dropdown.",
                "kind": "Grouping"
            },
            {
                "name": "boundary1",
                "displayName": "Boundary 1 (e.g. Suburb)",
                "description": "Column whose values match the names in boundary layer 1. Clicking a shape, or picking it in the header, filters on this column.",
                "kind": "Grouping"
            },
            {
                "name": "boundary2",
                "displayName": "Boundary 2 (e.g. Ward)",
                "description": "Column whose values match the names in boundary layer 2.",
                "kind": "Grouping"
            },
            {
                "name": "title",
                "displayName": "Title",
                "description": "Popup heading; also what the header search box searches.",
                "kind": "Grouping"
            },
            {
                "name": "description",
                "displayName": "Description",
                "description": "Text shown in the popup under the status.",
                "kind": "Grouping"
            },
            {
                "name": "completionDate",
                "displayName": "Completion date",
                "description": "Date shown in the popup. The row label is this field's name.",
                "kind": "Grouping"
            },
            {
                "name": "photoUrl",
                "displayName": "Photo URL",
                "description": "One https image URL, or several separated by | for a carousel.",
                "kind": "Grouping"
            },
            {
                "name": "photoOrientation",
                "displayName": "Photo orientation",
                "description": "landscape or portrait (pipe-separated per photo when using a carousel).",
                "kind": "Grouping"
            },
            {
                "name": "currentYearFunds",
                "displayName": "Current year funds",
                "description": "Money row in the popup. The row label is this field's name.",
                "kind": "Grouping",
                "requiredTypes": [
                    {
                        "numeric": true
                    },
                    {
                        "integer": true
                    }
                ]
            },
            {
                "name": "futureYearFunds",
                "displayName": "Future year funds",
                "description": "Money row in the popup. The row label is this field's name.",
                "kind": "Grouping",
                "requiredTypes": [
                    {
                        "numeric": true
                    },
                    {
                        "integer": true
                    }
                ]
            },
            {
                "name": "budget",
                "displayName": "Budget",
                "description": "Summed per category for the info-panel chart; shown in the popup and totalled on the stats card.",
                "kind": "Measure",
                "requiredTypes": [
                    {
                        "numeric": true
                    },
                    {
                        "integer": true
                    }
                ]
            },
            {
                "name": "budgetBand",
                "displayName": "Budget band",
                "description": "A banding column (for example < $100k, $100k - $500k) for the header Budget dropdown.",
                "kind": "Grouping"
            },
            {
                "name": "updatedOn",
                "displayName": "Updated on",
                "description": "Date or text for the legend footer, for example the data refresh date.",
                "kind": "GroupingOrMeasure"
            },
            {
                "name": "tooltips",
                "displayName": "Tooltips",
                "kind": "Grouping",
                "description": "Any fields for the hover tooltip."
            }
        ],
