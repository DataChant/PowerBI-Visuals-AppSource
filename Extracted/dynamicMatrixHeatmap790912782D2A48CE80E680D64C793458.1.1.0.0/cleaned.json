    "capabilities": {
        "dataRoles": [
            {
                "displayName": "Dimensions",
                "displayNameKey": "Visual_Dimensions",
                "name": "dimensions",
                "kind": "Grouping",
                "description": "Fields available in the X and Y dropdowns. Up to 10 (Free: 3)."
            },
            {
                "displayName": "Measures",
                "displayNameKey": "Visual_Measures",
                "name": "measures",
                "kind": "Measure",
                "description": "Pre-aggregated DAX measures. Re-aggregated with the mode selected in the Values card. Up to 5 (Free: 2)."
            },
            {
                "name": "weights",
                "kind": "Measure",
                "displayName": "Weights for averages",
                "displayNameKey": "Visual_Weights",
                "description": "A row count, so averages can be combined correctly across the dimensions you did not pick for X and Y. Without it the visual can only average the averages Power BI sent, which weighs every combination the same."
            },
            {
                "displayName": "Distinct count of (Pro)",
                "displayNameKey": "Visual_DistinctFields",
                "name": "distinctFields",
                "kind": "Grouping",
                "description": "Raw ID columns (e.g. customer_id). The visual counts unique values itself, so the result is always correct for any X/Y combination \u2014 unlike summing a DAX measure."
            }
        ],
        "dataViewMappings": [
            {
                "conditions": [
                    {
                        "dimensions": {
                            "min": 0,
                            "max": 10
                        },
                        "measures": {
                            "min": 0,
                            "max": 5
                        },
                        "weights": {
                            "min": 0,
                            "max": 1
                        },
                        "distinctFields": {
                            "min": 0,
                            "max": 3
                        }
                    }
                ],
                "categorical": {
                    "categories": {
                        "select": [
                            {
                                "for": {
                                    "in": "dimensions"
                                }
                            },
                            {
                                "for": {
                                    "in": "distinctFields"
                                }
                            }
                        ],
                        "dataReductionAlgorithm": {
                            "window": {
                                "count": 30000
                            }
                        }
                    },
                    "values": {
                        "select": [
                            {
                                "for": {
                                    "in": "measures"
                                }
                            },
                            {
                                "for": {
                                    "in": "weights"
                                }
                            }
                        ]
                    }
                }
            }
