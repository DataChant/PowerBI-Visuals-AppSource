            "Prop_ScYesterday": "Ontem",
            "Prop_ScThisWeek": "Esta Semana",
            "Prop_ScLastWeek": "Semana Passada",
            "Prop_ScThisMonth": "Este M\u00eas",
            "Prop_ScLastMonth": "M\u00eas Passado",
            "Prop_ScMtd": "M\u00eas at\u00e9 \u00e0 data",
            "Prop_ScQtd": "Trimestre at\u00e9 \u00e0 data",
            "Prop_ScYtd": "Ano at\u00e9 \u00e0 data",
            "Prop_ScThisQuarter": "Este Trimestre",
            "Prop_ScLastQuarter": "Trimestre Passado",
            "Prop_ScThisSemester": "Este Semestre",
            "Prop_ScLastSemester": "Semestre Passado",
            "Prop_ScThisYear": "Este Ano",
            "Prop_ScDynamic": "\u00daltimos N",
            "Card_GranularityOptions": "Granularidades Vis\u00edveis",
            "Prop_AutoGranularity": "Granularidade autom\u00e1tica",
            "Prop_AutoGranularity_Desc": "Ligado: a granularidade escolhida acima \u00e9 s\u00f3 uma sugest\u00e3o \u2014 se o intervalo selecionado tiver poucos pontos nesse n\u00edvel (ou esse n\u00edvel estiver desligado), desce automaticamente para o pr\u00f3ximo n\u00edvel dispon\u00edvel. A grelha mostrada nunca muda sozinha; s\u00f3 o filtro efetivo enviado aos outros visuais \u00e9 que pode ser diferente do n\u00edvel clicado. Desligado: for\u00e7a sempre o n\u00edvel escolhido, sem downgrade nenhum. Este \u00e9 o valor inicial \u2014 se o interruptor abaixo estiver vis\u00edvel, o utilizador pode mudar isto durante a sess\u00e3o.",
            "Prop_ShowAutoGranToggle": "Mostrar interruptor Autom\u00e1tico/Manual ao utilizador",
            "Prop_ShowAutoGranToggle_Desc": "Mostra, dentro do pr\u00f3prio seletor, um interruptor que permite a quem v\u00ea o relat\u00f3rio trocar entre granularidade autom\u00e1tica e manual. A escolha n\u00e3o fica gravada \u2014 reinicia sempre no valor de \"Granularidade autom\u00e1tica\" acima ao reabrir o relat\u00f3rio.",
            "Prop_GranD": "Di\u00e1rio (D)",
            "Prop_GranW": "Semanal (W)",
            "Prop_GranWThreshold": "W \u2014 m\u00ednimo de semanas",
            "Prop_GranM": "Mensal (M)",
            "Prop_GranMThreshold": "M \u2014 m\u00ednimo de meses",
            "Prop_GranQ": "Trimestral (Q)",
            "Prop_GranQThreshold": "Q \u2014 m\u00ednimo de trimestres",
            "Prop_GranS": "Semestral (S)",
            "Prop_GranSThreshold": "S \u2014 m\u00ednimo de semestres",
            "Prop_GranY": "Anual (Y)",
            "Prop_GranYThreshold": "Y \u2014 m\u00ednimo de anos"
        }
