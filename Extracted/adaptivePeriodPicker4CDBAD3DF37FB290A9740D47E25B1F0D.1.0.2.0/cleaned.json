            {
                "conditions": [
                    {
                        "dateColumn": {
                            "max": 1
                        },
                        "langMeasure": {
                            "max": 1
                        },
                        "refDateMeasure": {
                            "max": 1
                        },
                        "granColumn": {
                            "max": 1
                        }
                    }
                ],
                "categorical": {
                    "categories": {
                        "select": [
                            {
                                "for": {
                                    "in": "dateColumn"
                                }
                            },
                            {
                                "for": {
                                    "in": "granColumn"
                                }
                            }
                        ],
                        "dataReductionAlgorithm": {
                            "top": {
                                "count": 30000
                            }
                        }
                    },
                    "values": {
                        "select": [
                            {
                                "bind": {
                                    "to": "langMeasure"
                                }
                            },
                            {
                                "bind": {
                                    "to": "refDateMeasure"
                                }
                            }
                        ]
                    }
                }
            }
