            "Prop_GranQThreshold": "Q \u2014 minimum quarters",
            "Prop_GranS": "Semi-annual (S)",
            "Prop_GranSThreshold": "S \u2014 minimum semesters",
            "Prop_GranY": "Annual (Y)",
            "Prop_GranYThreshold": "Y \u2014 minimum years"
        },
        "pt-PT": {
            "Role_DateColumn": "Coluna de Data",
            "Role_GranColumn": "Coluna de Granularidade (opcional)",
            "Role_GranColumn_Desc": "Coluna f\u00edsica com c\u00f3digos de granularidade (D/W/M/Q/S/Y), ex. AUX_PERIOD[Aux_Period]. Pode ser uma tabela desligada pequena e normal \u2014 n\u00e3o precisa de cartesian join nem de tratamento especial. Quando associada, a granularidade passa a fazer parte do mesmo filtro real, sincronizado entre p\u00e1ginas, que o intervalo de datas. Quando n\u00e3o associada, o seletor continua a funcionar por completo; a granularidade fica apenas visual (sem filtro real enviado especificamente para ela).",
            "Role_Language": "Idioma",
            "Role_RefDate": "Data de Refer\u00eancia (opcional)",
            "Card_DataColors": "Cores e Texto",
            "Prop_BackgroundColor": "Fundo principal",
            "Prop_BackgroundOpacity": "Transpar\u00eancia do fundo principal (%)",
            "Prop_PanelColor": "Fundo de caixas / inputs",
            "Prop_PanelOpacity": "Transpar\u00eancia do fundo de caixas (%)",
            "Prop_HoverRevealOpacity": "Transpar\u00eancia da \u00e1rea expans\u00edvel (%)",
            "Prop_HoverRevealOpacity_Desc": "S\u00f3 se aplica com \"Mostrar apenas ao passar o rato\" ativo (Modo de Exibi\u00e7\u00e3o). Controla a transpar\u00eancia do fundo da zona que s\u00f3 aparece ao passar o rato \u2014 independente da transpar\u00eancia do fundo principal.",
            "Prop_AccentColor": "Cor de destaque (sele\u00e7\u00e3o / bot\u00e3o aplicar)",
            "Prop_TitleColor": "Cor de t\u00edtulos / setas / texto secund\u00e1rio",
            "Prop_ValueColor": "Cor de valores / texto principal",
            "Prop_AccentTextColor": "Texto sobre a cor de destaque",
            "Prop_FontFamilyGran": "Tipo de letra \u2014 Granularidade",
            "Prop_FontSizeGran": "Tamanho \u2014 Granularidade (pt)",
            "Prop_FontFamilyShortcuts": "Tipo de letra \u2014 Atalhos",
            "Prop_FontSizeShortcuts": "Tamanho \u2014 Atalhos (pt)",
            "Prop_FontFamilyContent": "Tipo de letra \u2014 Calend\u00e1rio",
            "Prop_FontSizeContent": "Tamanho \u2014 Calend\u00e1rio (pt)",
            "Prop_FontFamilySide": "Tipo de letra \u2014 Painel de Controlo",
            "Prop_FontSizeSide": "Tamanho \u2014 Painel de Controlo (pt)",
            "Prop_BorderColor": "Cor do rebordo",
            "Prop_BorderWidth": "Espessura do rebordo (px)",
            "Prop_ResizerColor": "Cor dos separadores de arrasto",
            "Prop_ResizerThickness": "Espessura dos separadores de arrasto (px)",
            "Card_DisplayMode": "Modo de Exibi\u00e7\u00e3o",
            "Prop_LayoutMode": "Modo de exibi\u00e7\u00e3o",
            "Prop_LayoutMode_Desc": "Pop-up: abre um di\u00e1logo nativo do Power BI ao clicar (pode mostrar aviso 'n\u00e3o mostrar novamente'). Inline Vertical: calend\u00e1rio sempre vis\u00edvel, layout em coluna. Inline Horizontal: calend\u00e1rio sempre vis\u00edvel, layout em linha \u2014 pensado para barras largas e baixas no topo da p\u00e1gina.",
            "Enum_Popup": "Pop-up",
            "Enum_InlineVertical": "Inline Vertical",
            "Enum_InlineHorizontal": "Inline Horizontal",
            "Prop_ApplyMode": "Modo de aplica\u00e7\u00e3o",
            "Prop_HoverExpand": "Mostrar apenas ao passar o rato",
            "Prop_LockResizers": "Bloquear tamanhos (separadores de arrasto)",
            "Prop_LockResizers_Desc": "Ajuste os separadores de arrasto (atalhos, calend\u00e1rio, In\u00edcio/Fim, etc.) enquanto esta op\u00e7\u00e3o est\u00e1 desativada; depois de ficar satisfeito com os tamanhos, ative-a para os fixar nesse estado \u2014 os separadores deixam de responder a arrastar ou duplo clique, tanto para si como para quem vir o relat\u00f3rio publicado. Exce\u00e7\u00e3o: o separador do painel de atalhos mant\u00e9m-se sempre livre, mesmo com isto ativo.",
            "Prop_ApplyMode_Desc": "Imediato: clicar num atalho (ou no 2.\u00ba clique de uma sele\u00e7\u00e3o manual) aplica o filtro logo, sem bot\u00f5es. Confirmar: mostra os bot\u00f5es Aplicar/Cancelar e o filtro s\u00f3 \u00e9 aplicado ao confirmar.",
            "Prop_PopupWidth": "Largura do pop-up (px)",
            "Prop_PopupWidth_Desc": "S\u00f3 se aplica no modo Pop-up. O m\u00ednimo absoluto permitido pelo Power BI \u00e9 240px, mas por baixo de ~380px a barra de atalhos e a grelha do calend\u00e1rio deste di\u00e1logo come\u00e7am a n\u00e3o caber e pode voltar a aparecer scroll horizontal.",
            "Prop_PopupHeight": "Altura do pop-up (px)",
            "Prop_PopupHorizontalAnchor": "Lado de abertura do pop-up",
            "Enum_AnchorRight": "Direita (a partir do visual)",
            "Enum_AnchorLeft": "Esquerda (a partir do visual)",
            "Enum_Immediate": "Imediato",
            "Enum_Confirm": "Confirmar",
            "Card_DefaultPeriod": "Per\u00edodo Predefinido",
            "Prop_DefaultType": "Per\u00edodo predefinido",
            "Prop_DefaultType_Desc": "Define o per\u00edodo aplicado pelo bot\u00e3o de atualiza\u00e7\u00e3o (\u27f3). '\u00daltimos N' usa o n\u00famero abaixo, sens\u00edvel \u00e0 granularidade.",
            "Enum_Today": "Hoje",
            "Enum_Yesterday": "Ontem",
            "Enum_ThisWeek": "Esta Semana",
            "Enum_LastWeek": "Semana Passada",
            "Enum_ThisMonth": "Este M\u00eas",
