        "dataViewMappings": [
            {
                "conditions": [
                    {
                        "Category": {
                            "max": 1
                        },
                        "X": {
                            "max": 1
                        },
                        "Y": {
                            "max": 1
                        },
                        "Series": {
                            "max": 1
                        },
                        "Size": {
                            "max": 1
                        },
                        "Gradient": {
                            "max": 1
                        },
                        "Tooltips": {
                            "max": 5
                        }
                    }
                ],
                "categorical": {
                    "categories": {
                        "for": {
                            "in": "Category"
                        },
                        "dataReductionAlgorithm": {
                            "window": {
                                "count": 10000
                            }
                        }
                    },
                    "values": {
                        "group": {
                            "by": "Series",
                            "select": [
                                {
                                    "for": {
                                        "in": "X"
                                    }
                                },
                                {
                                    "for": {
                                        "in": "Y"
                                    }
                                },
                                {
                                    "for": {
                                        "in": "Size"
                                    }
                                },
                                {
                                    "for": {
                                        "in": "Gradient"
                                    }
                                },
                                {
                                    "for": {
                                        "in": "Tooltips"
                                    }
                                }
                            ]
                        }
                    }
                }
            }
        ],
        "supportsHighlight": true,
        "supportsMultiVisualSelection": true,
        "supportsKeyboardFocus": true,
