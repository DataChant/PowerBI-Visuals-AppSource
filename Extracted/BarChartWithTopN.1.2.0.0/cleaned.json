{
    "visual": {
        "name": "BarChartWithTopN",
        "displayName": "BarChartWithTopN",
        "guid": "BarChartWithTopN",
        "visualClassName": "Visual",
        "version": "1.2.0.0",
        "description": "Show the line chart for grouped data by categories and data. The points on the chart will be dynamic bassed of data field provided",
        "supportUrl": "https://github.com/Narendar-OfficeSolution",
        "gitHubUrl": "https://github.com/Narendar-OfficeSolution"
    },
    "author": {
        "name": "Office Solution",
        "email": "narendar@innovationalofficesolution.com"
    },
    "apiVersion": "5.11.0",
    "style": "style/visual.less",
    "stringResources": {},
    "capabilities": {
        "dataRoles": [
            {
                "displayNameKey": "Visual_Source",
                "name": "Source",
                "kind": "Grouping",
                "displayName": "Value Field X"
            },
            {
                "displayNameKey": "Visual_Target_Y",
                "name": "Yvalue",
                "kind": "Measure",
                "displayName": "Value Field Y (Numeric)"
            },
            {
                "displayName": "Tooltip",
                "name": "tooltip",
                "kind": "Measure"
            }
        ],
        "dataViewMappings": [
            {
                "conditions": [
                    {
                        "tooltip": {
                            "max": 4
                        }
                    }
                ],
                "categorical": {
                    "categories": {
                        "select": [
                            {
                                "for": {
                                    "in": "Source"
                                }
                            },
                            {
                                "for": {
                                    "in": "Yvalue"
                                }
                            }
                        ],
                        "dataReductionAlgorithm": {
                            "sample": {
                                "count": 999999999
                            }
                        }
                    },
                    "values": {
                        "select": [
                            {
                                "bind": {
                                    "to": "tooltip"
                                }
                            }
                        ]
                    }
                }
            }
        ],
        "objects": {
            "numericalValueFormatter": {
                "displayName": "Numerical Value Formatter",
                "properties": {
                    "valueFormatter": {
                        "displayName": "Value Formatter",
                        "type": {
                            "enumeration": [
                                {
                                    "value": "auto",
                                    "displayName": "Auto"
                                },
                                {
                                    "value": "k",
                                    "displayName": "M"
                                },
                                {
                                    "value": "m",
                                    "displayName": "MM"
                                },
                                {
                                    "value": "b",
                                    "displayName": "B"
                                },
                                {
                                    "value": "t",
                                    "displayName": "T"
                                },
                                {
                                    "value": "none",
                                    "displayName": "None"
                                }
                            ]
                        }
                    }
                }
            },
            "barTextAlignment": {
                "displayName": "Bar Text Alignment",
                "properties": {
                    "positions": {
                        "displayName": "Positions",
                        "type": {
                            "enumeration": [
                                {
                                    "value": "none",
                                    "displayName": "None"
                                },
                                {
                                    "value": "top",
                                    "displayName": "Top"
                                },
                                {
                                    "value": "bottom",
                                    "displayName": "Bottom"
                                },
                                {
                                    "value": "center",
                                    "displayName": "Center"
                                }
                            ]
                        }
                    }
                }
            },
            "sorting": {
                "displayName": "Sorting",
                "properties": {
                    "sortType": {
                        "displayName": "Sort Type",
                        "type": {
                            "enumeration": [
                                {
                                    "value": "asc",
                                    "displayName": "Ascending"
                                },
                                {
                                    "value": "desc",
                                    "displayName": "Descending"
                                }
                            ]
                        }
                    }
                }
            },
            "axisLables": {
                "displayName": "Axis Labels",
                "properties": {
                    "xaxisLable": {
                        "displayName": "X Axis Label",
                        "type": {
                            "text": true
                        }
                    },
                    "yaxisLable": {
                        "displayName": "Y Axis Label",
                        "type": {
                            "text": true
                        }
                    }
                }
            }
        },
        "tooltips": {
            "supportedTypes": {
                "default": true,
                "canvas": true
            },
            "roles": [
                "Tooltips"
            ]
        },
        "privileges": []
    },
    "visualEntryPoint": "",
    "externalJS": [],
    "assets": {
        "icon": "assets/icon.png"
    }
}