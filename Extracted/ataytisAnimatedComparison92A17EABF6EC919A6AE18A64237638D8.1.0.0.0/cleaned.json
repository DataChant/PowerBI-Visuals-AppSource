        "tooltips": {
            "supportedTypes": {
                "default": true,
                "canvas": false
            },
            "roles": [
                "category",
                "breakdown",
                "measure",
                "lineMeasure",
                "comparison",
                "minimum",
                "maximum",
                "leaderboardColumn",
                "tooltips"
            ],
            "supportEnhancedTooltips": true
        },
        "dataViewMappings": [
            {
                "conditions": [
                    {
                        "category": {
                            "max": 1
                        },
                        "breakdown": {
                            "max": 1
                        },
                        "imageUri": {
                            "max": 1
                        },
                        "axis": {
                            "max": 1
                        },
                        "measure": {
                            "max": 1
                        },
                        "lineMeasure": {
                            "max": 8
                        },
                        "comparison": {
                            "max": 1
                        },
                        "minimum": {
                            "max": 1
                        },
                        "maximum": {
                            "max": 1
                        },
                        "gaugeTarget": {
                            "max": 4
                        },
                        "leaderboardColumn": {
                            "max": 16
                        },
                        "tooltips": {
                            "max": 10
                        }
                    }
                ],
                "categorical": {
                    "categories": {
                        "select": [
                            {
                                "bind": {
                                    "to": "category"
                                }
                            },
                            {
                                "bind": {
                                    "to": "breakdown"
                                }
                            },
                            {
                                "bind": {
                                    "to": "imageUri"
                                }
                            }
                        ],
                        "dataReductionAlgorithm": {
                            "top": {
                                "count": 3000
                            }
                        }
                    },
                    "values": {
                        "group": {
                            "by": "axis",
                            "select": [
                                {
                                    "bind": {
                                        "to": "measure"
                                    }
                                },
                                {
                                    "for": {
                                        "in": "lineMeasure"
                                    }
                                },
                                {
                                    "bind": {
                                        "to": "comparison"
                                    }
                                },
                                {
                                    "bind": {
                                        "to": "minimum"
                                    }
                                },
                                {
                                    "bind": {
                                        "to": "maximum"
                                    }
                                },
                                {
                                    "for": {
                                        "in": "gaugeTarget"
                                    }
                                },
                                {
                                    "for": {
                                        "in": "leaderboardColumn"
                                    }
                                },
                                {
                                    "for": {
                                        "in": "tooltips"
                                    }
                                }
                            ],
                            "dataReductionAlgorithm": {
                                "top": {
                                    "count": 10000
                                }
                            }
                        }
                    }
                }
            }
        ],
