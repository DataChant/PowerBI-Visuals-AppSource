    "capabilities": {
        "dataRoles": [
            {
                "displayName": "Entity",
                "name": "category",
                "kind": "Grouping",
                "description": "Category field to rank (customer, product, SKU\u2026)"
            },
            {
                "displayName": "Value",
                "name": "measure",
                "kind": "Measure",
                "description": "Numeric measure to concentrate (sales, revenue, liters\u2026)"
            },
            {
                "displayName": "Tooltips",
                "name": "tooltips",
                "kind": "Measure",
                "description": "Additional measures to display in tooltips"
            }
        ],
        "dataViewMappings": [
            {
                "conditions": [
                    {
                        "category": {
                            "max": 1
                        },
                        "measure": {
                            "max": 1
                        },
                        "tooltips": {
                            "max": 10
                        }
                    }
                ],
                "categorical": {
                    "categories": {
                        "for": {
                            "in": "category"
                        },
                        "dataReductionAlgorithm": {
                            "window": {
                                "count": 30000
                            }
                        }
                    },
                    "values": {
                        "select": [
                            {
                                "bind": {
                                    "to": "measure"
                                }
                            },
                            {
                                "bind": {
                                    "to": "tooltips"
                                }
                            }
                        ]
                    }
                }
            }
        ],
