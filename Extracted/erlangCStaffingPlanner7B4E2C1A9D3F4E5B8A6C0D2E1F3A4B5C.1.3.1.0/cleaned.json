{
    "visual": {
        "name": "erlangCStaffingPlanner",
        "displayName": "Erlang C Staffing Planner",
        "guid": "erlangCStaffingPlanner7B4E2C1A9D3F4E5B8A6C0D2E1F3A4B5C",
        "visualClassName": "Visual",
        "version": "1.3.1.0",
        "description": "Calculates interval-level contact-centre staffing requirements with Erlang C, and shows required staff, scheduled staff, staffing gaps, expected service level and occupancy.",
        "supportUrl": "https://docs.work4wifi.com/support/",
        "gitHubUrl": "https://github.com/SaltyCap24/erlang-c-staffing-powerbi-visual"
    },
    "author": {
        "name": "SaltyCap",
        "email": "cap@work4wifi.com"
    },
    "apiVersion": "5.11.0",
    "style": "style/visual.less",
    "stringResources": {},
    "capabilities": {
        "privileges": [],
        "dataRoles": [
            {
                "displayName": "Interval",
                "displayNameKey": "Role_Interval",
                "description": "Beginning of each staffing interval. A date/time field, or any sortable category.",
                "name": "interval",
                "kind": "Grouping"
            },
            {
                "displayName": "Forecast contacts",
                "displayNameKey": "Role_Contacts",
                "description": "Contacts offered during the interval. Normally summed.",
                "name": "contacts",
                "kind": "Measure",
                "requiredTypes": [
                    {
                        "numeric": true
                    },
                    {
                        "integer": true
                    }
                ]
            },
            {
                "displayName": "Average handle time (seconds)",
                "displayNameKey": "Role_Aht",
                "description": "Weighted average handle time at the interval grain. Use DIVIDE(SUM(HandleSeconds), SUM(Contacts)) rather than an average of averages.",
                "name": "ahtSeconds",
                "kind": "Measure",
                "requiredTypes": [
                    {
                        "numeric": true
                    },
                    {
                        "integer": true
                    }
                ]
            },
            {
                "displayName": "Scheduled agents",
                "displayNameKey": "Role_Scheduled",
                "description": "Agents scheduled for the interval. Optional. Must be staffing at the interval grain, not a sum of repeated row values.",
                "name": "scheduledAgents",
                "kind": "Measure",
                "requiredTypes": [
                    {
                        "numeric": true
                    },
                    {
                        "integer": true
                    }
                ]
            },
            {
                "displayName": "Queue or group",
                "displayNameKey": "Role_Queue",
                "description": "Optional grouping used for filtering, selection and tooltip context.",
                "name": "queue",
                "kind": "Grouping"
            },
            {
                "displayName": "Target service level %",
                "displayNameKey": "Role_targetServiceLevelOverride",
                "description": "Optional. Overrides the Format-pane value so report readers can adjust it with a what-if parameter. Whole-number percent, e.g. 80.",
                "name": "targetServiceLevelOverride",
                "kind": "Measure",
                "requiredTypes": [
                    {
                        "numeric": true
                    },
                    {
                        "integer": true
                    }
                ]
            },
            {
                "displayName": "Answer within (seconds)",
                "displayNameKey": "Role_answerThresholdOverride",
                "description": "Optional. Overrides the Format-pane answer-time threshold. In seconds.",
                "name": "answerThresholdOverride",
                "kind": "Measure",
                "requiredTypes": [
                    {
                        "numeric": true
                    },
                    {
                        "integer": true
                    }
                ]
            },
            {
                "displayName": "Shrinkage %",
                "displayNameKey": "Role_shrinkageOverride",
                "description": "Optional. Overrides the Format-pane shrinkage. Whole-number percent, e.g. 30.",
                "name": "shrinkageOverride",
                "kind": "Measure",
                "requiredTypes": [
                    {
                        "numeric": true
                    },
                    {
                        "integer": true
                    }
                ]
            },
            {
                "displayName": "Maximum occupancy %",
                "displayNameKey": "Role_maxOccupancyOverride",
                "description": "Optional. Overrides the Format-pane occupancy cap. Whole-number percent, e.g. 85.",
                "name": "maxOccupancyOverride",
                "kind": "Measure",
                "requiredTypes": [
                    {
                        "numeric": true
                    },
                    {
                        "integer": true
                    }
                ]
            }
        ],
