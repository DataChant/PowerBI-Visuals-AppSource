    "capabilities": {
        "dataRoles": [
            {
                "name": "caseId",
                "kind": "Grouping",
                "displayName": "Case ID",
                "displayNameKey": "Role_CaseId_DisplayName",
                "description": "Unique identifier for each process case (e.g. invoice number)",
                "descriptionKey": "Role_CaseId_Description"
            },
            {
                "name": "activity",
                "kind": "Grouping",
                "displayName": "Activity",
                "displayNameKey": "Role_Activity_DisplayName",
                "description": "Name of the process step / event type",
                "descriptionKey": "Role_Activity_Description"
            },
            {
                "name": "timestamp",
                "kind": "Grouping",
                "displayName": "Timestamp",
                "displayNameKey": "Role_Timestamp_DisplayName",
                "description": "Date/time when the activity occurred",
                "descriptionKey": "Role_Timestamp_Description"
            },
            {
                "name": "caseAttribute",
                "kind": "Grouping",
                "displayName": "Case Attribute (Benchmark)",
                "displayNameKey": "Role_CaseAttribute_DisplayName",
                "description": "Optional case-level attribute used to color-code activity nodes",
                "descriptionKey": "Role_CaseAttribute_Description"
            }
        ],
        "objects": {
            "general": {
                "properties": {
                    "filter": {
                        "type": {
                            "filter": {}
                        }
                    }
                }
            },
            "nodes": {
                "displayName": "Nodes",
                "displayNameKey": "Object_Nodes_DisplayName",
                "properties": {
                    "fillColor": {
                        "displayName": "Fill color",
                        "displayNameKey": "Object_Nodes_FillColor_DisplayName",
                        "type": {
                            "fill": {
                                "solid": {
                                    "color": true
                                }
                            }
                        }
                    },
                    "fontColor": {
                        "displayName": "Font color",
                        "displayNameKey": "Object_Nodes_FontColor_DisplayName",
                        "type": {
                            "fill": {
                                "solid": {
                                    "color": true
                                }
                            }
                        }
                    },
                    "fontSize": {
                        "displayName": "Font size",
                        "displayNameKey": "Object_Nodes_FontSize_DisplayName",
                        "type": {
                            "numeric": true
                        }
                    }
                }
            },
            "edges": {
                "displayName": "Edges",
                "displayNameKey": "Object_Edges_DisplayName",
                "properties": {
                    "color": {
                        "displayName": "Color",
                        "displayNameKey": "Object_Edges_Color_DisplayName",
                        "type": {
                            "fill": {
                                "solid": {
                                    "color": true
                                }
                            }
                        }
                    },
                    "showLabels": {
                        "displayName": "Show transition counts",
                        "displayNameKey": "Object_Edges_ShowLabels_DisplayName",
                        "type": {
                            "bool": true
                        }
                    }
                }
            },
            "netsuite": {
                "displayName": "NetSuite",
                "displayNameKey": "Object_NetSuite_DisplayName",
                "properties": {
                    "accountId": {
                        "displayName": "Account ID",
                        "displayNameKey": "Object_NetSuite_AccountId_DisplayName",
                        "type": {
                            "text": true
                        }
                    }
                }
            }
        },
        "dataViewMappings": [
            {
                "conditions": [
                    {
                        "caseId": {
                            "max": 1
                        },
                        "activity": {
                            "max": 1
                        },
                        "timestamp": {
                            "max": 1
                        }
                    }
                ],
                "table": {
                    "rows": {
                        "select": [
                            {
                                "for": {
                                    "in": "caseId"
                                }
                            },
                            {
                                "for": {
                                    "in": "activity"
                                }
                            },
                            {
                                "for": {
                                    "in": "timestamp"
                                }
                            },
                            {
                                "for": {
                                    "in": "caseAttribute"
                                }
                            }
                        ],
                        "dataReductionAlgorithm": {
                            "window": {
                                "count": 30000
                            }
                        }
                    }
                }
            }
        ],
        "supportsHighlight": false,
        "supportsKeyboardFocus": true,
        "privileges": []
    },
    "visualEntryPoint": "",
    "externalJS": [],
    "assets": {
        "icon": "assets/icon.png"
    }
