        "version": "1.1.0.2",
        "description": "Alluvial and temporal sentiment emotion flow river visual.",
        "supportUrl": "https://innovationalofficesolution.com/power-bi-custom-charts",
        "gitHubUrl": "https://github.com"
    },
    "author": {
        "name": "Hitesh",
