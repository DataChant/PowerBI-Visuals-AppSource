            {
                "displayName": "Time / Stage",
                "name": "timeStage",
                "kind": "Grouping"
            },
            {
                "displayName": "Sentiment / Emotion",
                "name": "sentimentEmotion",
                "kind": "Grouping"
            },
            {
                "displayName": "Volume / Count",
                "name": "volume",
                "kind": "Measure"
            },
            {
                "displayName": "Intensity / Score",
                "name": "intensity",
                "kind": "Measure"
            },
            {
                "displayName": "Text Sample",
                "name": "textSample",
                "kind": "Grouping"
            },
            {
                "displayName": "Topic / Key Phrase",
                "name": "topicPhrase",
                "kind": "Grouping"
            },
            {
                "displayName": "Channel / Product",
                "name": "channelProduct",
                "kind": "Grouping"
            }
        ],
        "objects": {},
        "dataViewMappings": [
            {
                "categorical": {
                    "categories": {
                        "select": [
                            {
                                "for": {
                                    "in": "timeStage"
                                }
                            },
                            {
                                "for": {
                                    "in": "sentimentEmotion"
                                }
                            },
                            {
                                "for": {
                                    "in": "textSample"
                                }
                            },
                            {
                                "for": {
                                    "in": "topicPhrase"
                                }
                            },
                            {
                                "for": {
                                    "in": "channelProduct"
                                }
                            }
                        ],
                        "dataReductionAlgorithm": {
                            "top": {}
                        }
                    },
                    "values": {
                        "select": [
                            {
                                "bind": {
                                    "to": "volume"
                                }
                            },
                            {
                                "bind": {
                                    "to": "intensity"
                                }
                            }
                        ]
                    }
                }
            }
        ],
        "privileges": []
    },
