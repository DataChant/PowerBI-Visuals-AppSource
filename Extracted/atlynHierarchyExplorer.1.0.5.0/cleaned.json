    "capabilities": {
        "privileges": [],
        "supportsKeyboardFocus": true,
        "supportsEmptyDataView": true,
        "supportsMultiVisualSelection": true,
        "tooltips": {
            "roles": [
                "Tooltips"
            ],
            "supportedTypes": {
                "default": true,
                "canvas": true
            },
            "supportEnhancedTooltips": true
        },
        "dataReductionCustomization": {
            "table": {
                "rowCount": {
                    "defaultValue": 30000
                }
            }
        },
        "dataRoles": [
            {
                "displayName": "Node ID",
                "displayNameKey": "Role_NodeId",
                "name": "NodeId",
                "kind": "Grouping",
                "requiredTypes": [
                    {
                        "text": true
                    },
                    {
                        "numeric": true
                    }
                ]
            },
            {
                "displayName": "Parent ID",
                "displayNameKey": "Role_ParentId",
                "name": "ParentId",
                "kind": "Grouping",
                "requiredTypes": [
                    {
                        "text": true
                    },
                    {
                        "numeric": true
                    }
                ]
            },
            {
                "displayName": "Label",
                "displayNameKey": "Role_Label",
                "name": "Label",
                "kind": "Grouping",
                "requiredTypes": [
                    {
                        "text": true
                    },
                    {
                        "numeric": true
                    }
                ]
            },
            {
                "displayName": "Subtitle",
                "displayNameKey": "Role_Subtitle",
                "name": "Subtitle",
                "kind": "Grouping",
                "requiredTypes": [
                    {
                        "text": true
                    },
                    {
                        "numeric": true
                    }
                ]
            },
            {
                "displayName": "Category",
                "displayNameKey": "Role_Category",
                "name": "Category",
                "kind": "Grouping",
                "requiredTypes": [
                    {
                        "text": true
                    },
                    {
                        "numeric": true
                    }
                ]
            },
            {
                "displayName": "Value",
                "displayNameKey": "Role_Value",
                "name": "Value",
                "kind": "Measure",
                "requiredTypes": [
                    {
                        "numeric": true
                    }
                ]
            },
            {
                "displayName": "Tooltips",
                "displayNameKey": "Role_Tooltips",
                "name": "Tooltips",
                "kind": "GroupingOrMeasure"
            }
        ],
        "dataViewMappings": [
            {
                "table": {
                    "rows": {
                        "select": [
                            {
                                "for": {
                                    "in": "NodeId"
                                }
                            },
                            {
                                "for": {
                                    "in": "ParentId"
                                }
                            },
                            {
                                "for": {
                                    "in": "Label"
                                }
                            },
                            {
                                "for": {
                                    "in": "Subtitle"
                                }
                            },
                            {
                                "for": {
                                    "in": "Category"
                                }
                            },
                            {
                                "for": {
                                    "in": "Value"
                                }
                            },
                            {
                                "for": {
                                    "in": "Tooltips"
                                }
                            }
                        ]
                    },
                    "dataReductionAlgorithm": {
                        "window": {
                            "count": 30000
                        }
                    }
                },
                "conditions": [
                    {
                        "NodeId": {
                            "max": 1
                        },
                        "ParentId": {
                            "max": 1
                        },
                        "Label": {
                            "max": 1
                        },
                        "Subtitle": {
                            "max": 1
                        },
                        "Category": {
                            "max": 1
                        },
                        "Value": {
                            "max": 1
                        },
                        "Tooltips": {
                            "max": 10
                        }
                    }
                ]
            }
        ],
        "objects": {
            "layout": {
                "displayNameKey": "Format_Layout_Card",
                "properties": {
                    "direction": {
                        "displayNameKey": "Format_Direction",
