    "capabilities": {
        "supportsLandingPage": true,
        "dataRoles": [
            {
                "displayName": "Hierarchy 1 \u2014 Horizontal",
                "name": "hierarchy1",
                "kind": "Grouping",
                "description": "Drives horizontal expansion \u2192. Add multiple fields for drill levels."
            },
            {
                "displayName": "Hierarchy 2 \u2014 Vertical",
                "name": "hierarchy2",
                "kind": "Grouping",
                "description": "Drives vertical expansion \u2193 from any H1 node. Add multiple fields for drill levels."
            },
            {
                "displayName": "Values (Max 4)",
                "name": "values",
                "kind": "Measure",
                "description": "Add up to 4 measures. Each measure appears as a KPI slot on every card, in the order you add them."
            },
            {
                "displayName": "Status Bar Color",
                "name": "statusBarColor",
                "kind": "Measure",
                "description": "DAX measure returning a hex color string, e.g. IF([vs Target]>0.05,\"#1D9E75\",\"#E8334A\")"
            },
            {
                "displayName": "KPI 1 Font Color",
                "name": "kpiFontColor1",
                "kind": "Measure",
