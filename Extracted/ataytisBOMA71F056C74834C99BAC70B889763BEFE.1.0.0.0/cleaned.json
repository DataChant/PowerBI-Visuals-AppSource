    "stringResources": {
        "en-US": {
            "Role_Parent_Name": "Parent",
            "Role_Parent_Description": "The assembly or product. A row with a blank parent declares a top-level product.",
            "Role_Component_Name": "Child",
            "Role_Component_Description": "The part or sub-assembly the parent uses. One row per parent and child.",
            "Role_Quantity_Name": "Quantity",
            "Role_Quantity_Description": "How many of the child one parent needs.",
            "Role_Details_Name": "Details",
            "Role_Details_Description": "Anything describing the child: description, position, status, supplier, cost.",
            "Role_Tooltips_Name": "Tooltips",
            "Role_Tooltips_Description": "Extra detail shown on hover only.",
            "Object_AdvancedEditor_Name": "Advanced editor",
            "Object_AdvancedEditor_Description": "Persisted Ataytis BOM configuration.",
            "Property_ConfigJson_Name": "BOM configuration",
            "Property_FormatPaneInfo_Name": "Configuration",
