                "descriptionKey": "Role_Parent_Description",
                "kind": "Grouping"
            },
            {
                "name": "component",
                "displayName": "Child",
                "displayNameKey": "Role_Component_Name",
                "description": "The part or sub-assembly the parent uses. One row per parent and child.",
                "descriptionKey": "Role_Component_Description",
                "kind": "Grouping"
            },
            {
                "name": "quantity",
                "displayName": "Quantity",
                "displayNameKey": "Role_Quantity_Name",
                "description": "How many of the child one parent needs.",
                "descriptionKey": "Role_Quantity_Description",
                "kind": "GroupingOrMeasure"
            },
            {
                "name": "details",
                "displayName": "Details",
                "displayNameKey": "Role_Details_Name",
                "description": "Anything describing the child: description, position, status, supplier, cost.",
                "descriptionKey": "Role_Details_Description",
                "kind": "GroupingOrMeasure"
            },
            {
                "name": "tooltips",
                "displayName": "Tooltips",
                "displayNameKey": "Role_Tooltips_Name",
                "description": "Extra detail shown on hover only.",
                "descriptionKey": "Role_Tooltips_Description",
                "kind": "GroupingOrMeasure"
            }
        ],
        "objects": {
            "advancedEditor": {
                "displayName": "Advanced editor",
                "displayNameKey": "Object_AdvancedEditor_Name",
                "description": "Persisted Ataytis BOM configuration.",
                "descriptionKey": "Object_AdvancedEditor_Description",
                "properties": {
                    "configJson": {
                        "displayName": "BOM configuration",
                        "displayNameKey": "Property_ConfigJson_Name",
                        "type": {
                            "text": true
                        }
                    },
                    "formatPaneInfo": {
                        "displayName": "Configuration",
                        "displayNameKey": "Property_FormatPaneInfo_Name",
                        "description": "Use Advanced edit mode to configure this visual.",
                        "descriptionKey": "Property_FormatPaneInfo_Description",
                        "type": {
                            "text": true
                        }
                    }
                }
            }
        },
        "dataViewMappings": [
            {
                "conditions": [
                    {
                        "parent": {
                            "max": 1
                        },
                        "component": {
                            "max": 1
                        },
                        "quantity": {
                            "max": 1
                        },
                        "details": {
                            "max": 60
                        },
                        "tooltips": {
                            "max": 50
                        }
                    }
                ],
                "table": {
                    "rows": {
                        "select": [
                            {
                                "for": {
                                    "in": "parent"
                                }
                            },
                            {
                                "for": {
                                    "in": "component"
                                }
                            },
                            {
                                "for": {
                                    "in": "quantity"
                                }
                            },
                            {
                                "for": {
                                    "in": "details"
                                }
                            },
                            {
                                "for": {
                                    "in": "tooltips"
                                }
                            }
                        ],
                        "dataReductionAlgorithm": {
                            "window": {
                                "count": 30000
                            }
                        }
                    }
                }
            }
        ],
        "sorting": {
            "custom": {}
        },
        "tooltips": {
            "supportedTypes": {
                "default": true,
                "canvas": true
            },
            "roles": [
                "parent",
                "component",
                "quantity",
                "details",
                "tooltips"
            ],
            "supportEnhancedTooltips": true
        },
        "privileges": [],
        "keepAllMetadataColumns": true,
        "suppressDefaultTitle": true,
        "supportsLandingPage": true,
