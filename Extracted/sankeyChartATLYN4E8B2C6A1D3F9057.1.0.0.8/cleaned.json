{
    "visual": {
        "name": "atlynSankeyChart",
        "displayName": "Atlyn Sankey Chart",
        "guid": "sankeyChartATLYN4E8B2C6A1D3F9057",
        "visualClassName": "Visual",
        "version": "1.0.0.8",
        "description": "Free Sankey diagram for Power BI. Visualize flow between nodes with proportional link widths.",
        "supportUrl": "https://www.atlynco.com/docs/faq",
        "gitHubUrl": "https://github.com/garrett-hamers/powerbi-sankey-chart"
    },
    "author": {
        "name": "Atlyn",
        "email": "partner@atlynco.com"
    },
    "apiVersion": "5.11.0",
    "style": "style/visual.less",
    "stringResources": {},
    "capabilities": {
        "supportsHighlight": true,
        "supportsKeyboardFocus": true,
        "supportsLandingPage": true,
        "supportsEmptyDataView": true,
        "supportsMultiVisualSelection": true,
        "tooltips": {
            "supportedTypes": {
                "default": true,
                "canvas": true
            },
            "roles": [
                "tooltips"
            ]
        },
        "dataRoles": [
            {
                "displayName": "Source",
                "name": "source",
                "kind": "Grouping",
                "description": "Origin node (e.g., Department, From-State)"
            },
            {
                "displayName": "Target",
                "name": "target",
                "kind": "Grouping",
                "description": "Destination node (e.g., Category, To-State)"
            },
            {
                "displayName": "Weight",
                "name": "weight",
                "kind": "Measure",
                "description": "Flow magnitude between source and target"
            },
            {
                "displayName": "Tooltips",
                "name": "tooltips",
                "kind": "Measure",
                "description": "Additional measures to show in tooltips"
            }
        ],
        "objects": {
            "chartSettings": {
                "properties": {
                    "nodeWidth": {
                        "type": {
                            "numeric": true
                        }
                    },
                    "nodeSort": {
                        "type": {
                            "enumeration": [
                                {
                                    "value": "auto",
                                    "displayName": "Auto"
                                },
                                {
                                    "value": "ascending",
                                    "displayName": "Ascending"
                                },
                                {
                                    "value": "descending",
                                    "displayName": "Descending"
                                },
                                {
                                    "value": "alphabetical",
                                    "displayName": "Alphabetical"
                                }
                            ]
                        }
                    },
                    "nodePadding": {
                        "type": {
                            "numeric": true
                        }
                    },
                    "linkColorMode": {
                        "type": {
                            "enumeration": [
                                {
                                    "value": "source",
                                    "displayName": "Source Color"
                                },
                                {
                                    "value": "target",
                                    "displayName": "Target Color"
                                },
                                {
                                    "value": "gradient",
                                    "displayName": "Gradient"
                                }
                            ]
                        }
                    }
                }
            },
            "title": {
                "properties": {
                    "show": {
                        "type": {
                            "bool": true
                        }
                    },
                    "titleText": {
                        "type": {
                            "text": true
                        }
                    },
                    "fontSize": {
                        "type": {
                            "numeric": true
                        }
                    },
                    "fontColor": {
                        "type": {
                            "fill": {
                                "solid": {
                                    "color": true
                                }
                            }
                        }
                    },
                    "alignment": {
                        "type": {
                            "enumeration": [
                                {
                                    "value": "left",
                                    "displayName": "Left"
                                },
                                {
                                    "value": "center",
                                    "displayName": "Center"
                                },
                                {
                                    "value": "right",
                                    "displayName": "Right"
                                }
                            ]
                        }
                    }
                }
            },
            "nodeLabels": {
                "properties": {
                    "show": {
                        "type": {
                            "bool": true
                        }
                    },
                    "fontSize": {
                        "type": {
                            "numeric": true
                        }
                    },
                    "fontColor": {
                        "type": {
                            "fill": {
                                "solid": {
                                    "color": true
                                }
                            }
                        }
                    },
                    "position": {
                        "type": {
                            "enumeration": [
                                {
                                    "value": "outside",
                                    "displayName": "Outside"
                                },
                                {
                                    "value": "inside",
                                    "displayName": "Inside"
                                }
                            ]
                        }
                    }
                }
            },
            "linkLabels": {
                "properties": {
                    "show": {
                        "type": {
                            "bool": true
                        }
                    },
                    "fontSize": {
                        "type": {
                            "numeric": true
                        }
                    },
                    "minWeight": {
                        "type": {
                            "numeric": true
                        }
                    }
                }
            },
            "design": {
                "properties": {
                    "nodeColor1": {
                        "type": {
                            "fill": {
                                "solid": {
                                    "color": true
                                }
                            }
                        }
                    },
                    "nodeColor2": {
                        "type": {
                            "fill": {
                                "solid": {
                                    "color": true
                                }
                            }
                        }
                    },
                    "nodeColor3": {
                        "type": {
                            "fill": {
                                "solid": {
                                    "color": true
                                }
                            }
                        }
                    },
                    "nodeColor4": {
                        "type": {
                            "fill": {
                                "solid": {
                                    "color": true
                                }
                            }
                        }
                    },
                    "nodeColor5": {
                        "type": {
                            "fill": {
                                "solid": {
                                    "color": true
                                }
                            }
                        }
                    },
                    "linkOpacity": {
                        "type": {
                            "numeric": true
                        }
                    },
                    "nodeCornerRadius": {
                        "type": {
                            "numeric": true
                        }
                    }
                }
            },
            "interaction": {
                "properties": {
                    "enableSelection": {
                        "type": {
                            "bool": true
                        }
                    },
                    "enableTooltips": {
                        "type": {
                            "bool": true
                        }
                    }
                }
            }
        },
        "dataViewMappings": [
            {
                "conditions": [
                    {
                        "source": {
                            "max": 1
                        },
                        "target": {
                            "max": 1
                        },
                        "weight": {
                            "max": 1
                        }
                    }
                ],
                "categorical": {
                    "categories": {
                        "select": [
                            {
                                "for": {
                                    "in": "source"
                                }
                            },
                            {
                                "for": {
                                    "in": "target"
                                }
                            }
                        ],
                        "dataReductionAlgorithm": {
                            "top": {
                                "count": 5000
                            }
                        }
                    },
                    "values": {
                        "select": [
                            {
                                "bind": {
                                    "to": "weight"
                                }
                            },
                            {
                                "for": {
                                    "in": "tooltips"
                                }
                            }
                        ]
                    }
                }
            }
        ],
        "privileges": []
    },
    "visualEntryPoint": "",
    "externalJS": [],
    "assets": {
        "icon": "assets/icon.png"
    }
}