{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Visuals released per year, split by certification.",
  "width": "container",
  "height": "container",
  "mark": { "type": "bar" },
  "encoding": {
    "x": {
      "field": "Year",
      "type": "ordinal",
      "title": null,
      "axis": { "labelAngle": 0 }
    },
    "y": { "field": "Visuals", "type": "quantitative", "title": "Visuals released", "stack": "zero" },
    "color": {
      "field": "Status",
      "type": "nominal",
      "title": null,
      "scale": { "domain": ["Certified", "Not certified"], "range": ["#F2C811", "#8A8886"] },
      "legend": { "orient": "top" }
    },
    "order": { "field": "Status", "sort": "ascending" },
    "tooltip": [
      { "field": "Year", "type": "ordinal" },
      { "field": "Status", "type": "nominal" },
      { "field": "Visuals", "type": "quantitative" }
    ]
  }
}
