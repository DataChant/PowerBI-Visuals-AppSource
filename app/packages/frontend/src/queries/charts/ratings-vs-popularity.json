{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Each visual's number of ratings against its popularity score.",
  "width": "container",
  "height": "container",
  "mark": { "type": "point", "style": "scatter", "filled": true, "size": 60 },
  "encoding": {
    "x": {
      "field": "Ratings",
      "type": "quantitative",
      "title": "Ratings (symmetric log scale)",
      "scale": { "type": "symlog" }
    },
    "y": {
      "field": "Score",
      "type": "quantitative",
      "title": "Popularity score",
      "scale": { "domain": [0, 100] }
    },
    "color": {
      "field": "Status",
      "type": "nominal",
      "title": null,
      "scale": { "domain": ["Certified", "Not certified"], "range": ["#F2C811", "#8A8886"] },
      "legend": { "orient": "top" }
    },
    "tooltip": [
      { "field": "Title", "type": "nominal", "title": "title" },
      { "field": "Thumbnail", "type": "nominal", "title": "image" },
      { "field": "Publisher", "type": "nominal" },
      { "field": "Ratings", "type": "quantitative" },
      { "field": "Score", "type": "quantitative", "title": "Popularity score" },
      { "field": "Status", "type": "nominal" }
    ]
  }
}
