{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "The share of raters who gave each number of stars, for the most rated publishers.",
  "width": "container",
  "height": "container",
  "mark": { "type": "bar" },
  "encoding": {
    "y": { "field": "Publisher", "type": "nominal", "title": null, "sort": null },
    "x": {
      "field": "Share",
      "type": "quantitative",
      "stack": "normalize",
      "title": "Share of raters",
      "axis": { "format": ".0%" }
    },
    "color": {
      "field": "Stars",
      "type": "ordinal",
      "title": null,
      "sort": ["1 star", "2 stars", "3 stars", "4 stars", "5 stars"],
      "scale": {
        "domain": ["1 star", "2 stars", "3 stars", "4 stars", "5 stars"],
        "range": ["#4A4846", "#8A8886", "#C8C6C4", "#F7DC6F", "#F2C811"]
      },
      "legend": { "orient": "top" }
    },
    "order": { "field": "Star Order", "type": "quantitative", "sort": "ascending" },
    "tooltip": [
      { "field": "Publisher", "type": "nominal" },
      { "field": "Stars", "type": "ordinal" },
      { "field": "Raters", "type": "quantitative" },
      { "field": "Share", "type": "quantitative", "format": ".0%" }
    ]
  }
}
