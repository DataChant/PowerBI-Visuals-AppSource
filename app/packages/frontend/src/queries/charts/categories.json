{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "How many visuals each Microsoft Marketplace category holds.",
  "width": "container",
  "height": "container",
  "encoding": {
    "y": { "field": "Category", "type": "nominal", "sort": "-x", "title": null },
    "x": { "field": "Visuals", "type": "quantitative", "title": null, "axis": null }
  },
  "layer": [
    {
      "mark": { "type": "bar" },
      "encoding": {
        "tooltip": [
          { "field": "Category", "type": "nominal" },
          { "field": "Visuals", "type": "quantitative" }
        ]
      }
    },
    {
      "mark": { "type": "text", "align": "left", "dx": 4 },
      "encoding": { "text": { "field": "Visuals", "type": "quantitative" } }
    }
  ]
}
