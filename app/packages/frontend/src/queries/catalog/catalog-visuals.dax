// One row per custom visual in the AppSource catalog. Every catalog page
// aggregates these rows in the browser, so a filter on one chart reshapes all
// of them without a round trip.
EVALUATE
SELECTCOLUMNS (
    'Custom Visuals',
    "ID", 'Custom Visuals'[ID],
    "Visual GUID", 'Custom Visuals'[Visual GUID],
    "Title", 'Custom Visuals'[Title],
    "Publisher", 'Custom Visuals'[Publisher],
    "Version", 'Custom Visuals'[Version],
    "Description", 'Custom Visuals'[Description],
    "Categories", 'Custom Visuals'[Categories],
    "Thumbnail", 'Custom Visuals'[Thumbnail],
    "Popularity", 'Custom Visuals'[Popularity],
    "Ratings", 'Custom Visuals'[# of Ratings],
    "Average Rating", 'Custom Visuals'[Average Rating],
    "Release Date", 'Custom Visuals'[Release Date],
    "Certified", 'Custom Visuals'[Certified],
    "Free Plans", 'Custom Visuals'[HasFreePlans],
    "Link", 'Custom Visuals'[Link],
    "Download Visual", 'Custom Visuals'[Download Visual]
)
