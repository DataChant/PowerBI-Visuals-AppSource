// The parts of a visual profile beyond its catalog row: the long description,
// publisher links and the preview video.
// __ID__ is replaced by the factory with a validated catalog ID.
EVALUATE
CALCULATETABLE (
    SELECTCOLUMNS (
        'Custom Visuals',
        "Long Summary", 'Custom Visuals'[Long Summary],
        "Download Sample", 'Custom Visuals'[Download Sample],
        "Support Link", 'Custom Visuals'[SupportLink],
        "Privacy Policy", 'Custom Visuals'[PrivacyPolicyUrl],
        "Legal Terms", 'Custom Visuals'[LegalTerms],
        "Video", CALCULATE ( MAX ( Videos[Video] ) ),
        "Video Preview", CALCULATE ( MAX ( Videos[Preview Image] ) )
    ),
    'Custom Visuals'[ID] = "__ID__"
)
