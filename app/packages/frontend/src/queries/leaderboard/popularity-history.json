{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Popularity score of one visual over time, on the same 0 to 100 scale as the rest of the app, drawn as a step line because the leaderboard records a row only when the figure changes.",
  "width": "container",
  "height": "container",
  "transform": [
    {
      "calculate": "datum['Popularity'] * 100",
      "as": "Score"
    }
  ],
  "mark": {
    "type": "line",
    "interpolate": "step-after",
    "strokeWidth": 2.5,
    "point": {
      "filled": true,
      "size": 40
    }
  },
  "encoding": {
    "x": {
      "field": "Snapshot Date",
      "type": "temporal",
      "title": null,
      "axis": {
        "format": "%b %Y",
        "tickCount": 5
      }
    },
    "y": {
      "field": "Score",
      "type": "quantitative",
      "title": "Popularity score",
      "scale": {
        "zero": false,
        "nice": true
      },
      "axis": {
        "format": ".1f",
        "tickMinStep": 0.1,
        "tickCount": 4
      }
    },
    "tooltip": [
      {
        "field": "Visual",
        "type": "nominal",
        "title": "title"
      },
      {
        "field": "Logo",
        "type": "nominal",
        "title": "image"
      },
      {
        "field": "Snapshot Date",
        "type": "temporal",
        "title": "Date",
        "format": "%b %d, %Y"
      },
      {
        "field": "Score",
        "type": "quantitative",
        "title": "Popularity score",
        "format": ".1f"
      },
      {
        "field": "Ratings",
        "type": "quantitative",
        "title": "Ratings"
      }
    ]
  }
}
